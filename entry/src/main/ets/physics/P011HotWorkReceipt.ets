 end(stage:number,start:number):void {if(start<0||!this.enabled)return;const now=Date.now(),cost=now-start;if(!Number.isFinite(cost)||cost<0){this.clockInvalid++;return;}this.totalMs[stage]+=cost;this.maxMs[stage]=Math.max(this.maxMs[stage],cost);}
 // Called only by the explicit diagnostic timer, never by patch/lease/audit.
 emitProgressCold():void {const now=Date.now();if(this.emit===null||now-this.lastEmit<1000||this.emitted===32)return;this.lastEmit=now;const line='T311_STAGE '+JSON.stringify({run:this.run,step:this.step,attempt:this.attempt,phase:this.phase,B:this.B,R:this.R,N:this.N,live:this.live,retry:this.retries,bytes:this.copiedBytes,counts:Array.from(this.counts),totalMs:Array.from(this.totalMs),maxMs:Array.from(this.maxMs)});if(line.length<=1800&&this.emittedBytes+line.length<=57600){this.emitted++;this.emittedBytes+=line.length;try{this.emit(line);}catch(e){this.clockInvalid++;}}else this.exportSkipped++;}
 next(run:number,step:number,attempt:number,B:number,N:number):void {if(!this.enabled)return;this.seal(0);this.counts.fill(0);this.totalMs.fill(0);this.maxMs.fill(0);this.run=run;this.step=step;this.attempt=attempt;this.B=B;this.N=N;this.phase=0;this.R=this.live=this.retries=this.copiedBytes=this.aliasComparisons=0;this.open=true;}
 seal(code:number):void {if(!this.enabled||!this.open)return;this.open=false;if(this.count===32){this.dropped++;return;}const at=this.count++*80;this.rows[at]=this.run;this.rows[at+1]=this.step;this.rows[at+2]=this.attempt;this.rows[at+3]=this.phase;this.rows[at+4]=this.B;this.rows[at+5]=this.R;this.rows[at+6]=this.N;this.rows[at+7]=this.live;this.rows[at+8]=this.retries;this.rows[at+9]=this.copiedBytes;this.rows[at+10]=this.aliasComparisons;this.rows[at+11]=code;this.rows[at+12]=this.clockInvalid;this.rows.set(this.counts,at+16);this.rows.set(this.totalMs,at+36);this.rows.set(this.maxMs,at+56);}
