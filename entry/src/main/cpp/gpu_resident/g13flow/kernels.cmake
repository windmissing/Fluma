set(G13_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(G13_REPO_DIR "${G13_MODULE_DIR}/../../../../../.." ABSOLUTE)
find_program(G13_PYTHON NAMES python python3 REQUIRED)
file(GLOB G13_INPUTS CONFIGURE_DEPENDS "${G13_MODULE_DIR}/*.glsl" "${G13_MODULE_DIR}/*.comp" "${G13_MODULE_DIR}/*.vert" "${G13_MODULE_DIR}/*.frag" "${G13_REPO_DIR}/docs/architecture-T607-g13-*-v1.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${G13_INPUTS} "${G13_REPO_DIR}/tools/g13/generate_assets.py")
set(G13_ASSET_DIR "${CMAKE_CURRENT_BINARY_DIR}/g13_assets")
set(G13_GENERATE_FLAGS)
if(GRS_G13_TEST_HOOKS)
 list(APPEND G13_GENERATE_FLAGS --test-hooks)
endif()
execute_process(COMMAND "${G13_PYTHON}" "${G13_REPO_DIR}/tools/g13/generate_assets.py" --out "${G13_ASSET_DIR}" ${G13_GENERATE_FLAGS} RESULT_VARIABLE G13_GENERATE_RESULT OUTPUT_VARIABLE G13_GENERATE_OUT ERROR_VARIABLE G13_GENERATE_ERR)
if(NOT G13_GENERATE_RESULT EQUAL 0)
 message(FATAL_ERROR "G13 asset generation failed: ${G13_GENERATE_ERR}")
endif()
foreach(G13_REQUIRED contract_generated.h layout_generated.glsl pipeline_source.h scene_sources.h assets_manifest.json)
 if(NOT EXISTS "${G13_ASSET_DIR}/${G13_REQUIRED}")
  message(FATAL_ERROR "G13 missing generated asset ${G13_REQUIRED}")
 endif()
endforeach()
