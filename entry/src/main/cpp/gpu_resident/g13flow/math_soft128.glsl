Soft softHalf(Soft a){--a.exponent;return a;}
Soft softPolynomial(Soft x,uint which){Soft z=softMul(x,x);if(which==0u){Soft y=softUnpack(SOFT_SIN[12]);for(int i=11;i>=0;--i)y=softAdd(softMul(y,z),softUnpack(SOFT_SIN[i]));return softMul(x,y);}Soft y=softUnpack(SOFT_COS[12]);for(int i=11;i>=0;--i)y=softAdd(softMul(y,z),softUnpack(SOFT_COS[i]));return y;}
// Payne-Hanek reduction with the complete 512-bit reciprocal. F32 theta's
