void mathDomain(uint detail){softDomain=true;localMathStatus|=detail;atomicOr(c[751],detail);failMath(localMathStatus);}
Soft softZero(){return Soft(uvec4(0u),0,false);}
Soft softUnpack(uvec4 raw){uint e=(raw.w>>16u)&32767u;bool n=(raw.w&0x80000000u)!=0u;raw.w&=65535u;if(e!=0u)raw.w|=65536u;return Soft(raw,int(e==0u?1u:e)-16383,n);}
