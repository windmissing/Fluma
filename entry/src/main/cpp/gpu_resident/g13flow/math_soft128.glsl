Soft softNeg(Soft a){a.negative=!a.negative;return a;}
Soft softAdd(Soft a,Soft b){if(wzero(a.sig))return b;if(wzero(b.sig))return a;if(a.exponent<b.exponent){Soft t=a;a=b;b=t;}uint shift=uint(min(a.exponent-b.exponent,128));uvec4 x=wshl(a.sig,3u),y=wshl(b.sig,3u);bool sticky=wlow(y,shift);y=wshr(y,shift);if(sticky)y.x|=1u;uvec4 s;bool n=a.negative;if(a.negative==b.negative)s=wadd(x,y);else if(wlt(x,y)){s=wsub(y,x);n=b.negative;}else s=wsub(x,y);int top=wtop(s);if(top<0)return softZero();int move=top-115;int e=a.exponent+move;if(move>0){bool st=wlow(s,uint(move));s=wshr(s,uint(move));if(st)s.x|=1u;}else s=wshl(s,uint(-move));s=wrne(s,3u);return softNormalize(s,e,n);}
