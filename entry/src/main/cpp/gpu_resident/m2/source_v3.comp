#version 310 es
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Base { uint B[]; };
layout(std430,binding=1) coherent buffer Candidate { uint C[]; };
layout(std430,binding=2) coherent buffer Workspace { uint W[]; };
layout(std430,binding=3) coherent buffer Output { uint E[]; };
/* INTEGER_AND_LAYOUT */
uniform uint uK,uKw,uPass,uEmitQ,uBaseBank,uPublicationSlot,uEventArena,uCarry,uUploaded;
uniform uvec2 uNonce,uFrame,uControl;
uniform int uBaseTangent;
const uint S=64u,T=32u,DEDUP=96u,CQ=268435456u;
#define uWater (16u*uK)
#define uColumn (uWater+16u*uKw)
#define uHeader (uColumn+2048u)
#define uWords (uHeader+256u)
#define uPad (uK==192u?256u:512u)
uint spare(){return DEDUP+4096u*64u;}
uint sourceEvents(){return spare()+uWords;}
uint index0(){return sourceEvents()+4096u*16u;}
uint ctrl(){return index0()+2u*uPad;}
uint origins(){return ctrl()+64u;}
uint config(){return origins()+8192u;}
uint pubWater(){return uWater;}
uint pubColumn(){return pubWater()+20u*uKw;}
uint pubHeader(){return pubColumn()+2048u;}
bool replaying=false;
// Publication uses the committed candidate even during replay. Return a loaded
// value so ordinary scalar parameters never receive a coherent storage lvalue.
uint m2CandidateValue(uint at){return C[at];}
uint st(uint at){return replaying?W[spare()+at]:C[at];}
void put(uint at,uint v){if(replaying)W[spare()+at]=v;else C[at]=v;}
uint h(uint i){return st(uHeader+i);}
void seth(uint i,uint v){put(uHeader+i,v);}
uint col(uint f,uint c){return st(uColumn+128u*f+c);}
void setcol(uint f,uint c,uint v){put(uColumn+128u*f+c,v);}
uvec2 hp(uint i){return uvec2(h(i),h(i+1u));}
void sethp(uint i,uvec2 v){seth(i,v.x);seth(i+1u,v.y);}
void failAt(uint why,uint ordinal,uint at){
    if(W[S]==4u)return;
    W[S]=4u;W[S+1u]=why;W[S+11u]=at;W[ctrl()+2u]=why;W[ctrl()+3u]=uPass+1u;W[ctrl()+4u]=ordinal;
}
void mismatch(uint why,uint ordinal,uint at,uint expected,uint actual){
    if(W[S]==4u)return;
    failAt(why,ordinal,at);W[S+16u]=expected;W[S+17u]=actual;
}
void fail(uint why){failAt(why,W[S+9u]+1u,0xffffffffu);}
uint controlBase(){return ctrl()+23u;}
uint cursor(){return replaying?W[controlBase()]:W[S+9u];}
void nextRow(){if(replaying)++W[controlBase()];else ++W[S+9u];}
void m2LoadSand(uint slot,out uint row[16]){for(uint f=0u;f<16u;++f)row[f]=st(f*uK+slot);}
void loadSlot(uint kind,uint slot,out uint row[16]){
    uint n=kind==0u?uK:uKw,base=kind==0u?0u:uWater;
    for(uint f=0u;f<16u;++f)row[f]=st(base+f*n+slot);
}
void putSlot(uint kind,uint slot,uint row[16]){
    uint n=kind==0u?uK:uKw,base=kind==0u?0u:uWater;
    for(uint f=0u;f<16u;++f)put(base+f*n+slot,row[f]);
}
/* OPERATIONS */
/* AUDIT_AND_DRIVER */
/* PUBLICATION */
void main(){
    uint i=gl_GlobalInvocationID.x,lane=gl_LocalInvocationIndex;
    if(uPass==0u){
        if(i<uWords)C[i]=B[i];
        if(i>=32u&&i<96u)W[i]=0u;
        if(i<64u)W[ctrl()+i]=0u;
        return;
    }
    if(uPass==12u){if(i==0u)sealCompletionV3();return;}
    if(W[S]==4u)return;
    replaying=uPass>=6u&&uPass<=8u;
    if(uPass==2u){if(i<uPad){W[index0()+i]=i;W[index0()+uPad+i]=i;}}
    else if(uPass==3u||uPass==7u)m2IndexSort(index0(),uPad,uK);
    else if(uPass==4u||uPass==8u)executeSource();
    else if(uPass==6u){if(i<uWords)W[spare()+i]=B[i];}
    else if(lane==0u){
        if(uPass==1u)preflight();
        if(uPass==5u)finalizeV3(false);
        if(uPass==9u)compareSource();
        if(uPass==10u)packPublication();
        if(uPass==11u&&!auditPublication())fail(15u);
    }
    // Completed dispatch stages 0..11. The seal records its own stage bit.
    // For bounded multi-group passes only group zero writes the mask word.
    if(i==0u&&W[S]!=4u)W[S+14u]|=(1u|(1u<<uPass));
}
