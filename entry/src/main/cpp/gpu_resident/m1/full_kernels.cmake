# Same LF assembly policy as test/gpu_resident/prepare_t280_commit.py.
foreach(M1_FILE quantum_replay.glsl quantum_geometry_audit.glsl quantum_seal.glsl quantum_commit_main.glsl full_source_audit.glsl)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/m1/${M1_FILE}")
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/m1/${M1_FILE}" M1_${M1_FILE})
 string(REPLACE "\r\n" "\n" M1_${M1_FILE} "${M1_${M1_FILE}}")
endforeach()
string(FIND "${M1_SOURCE_AUDIT}" "bool auditPublication(){" M1_PUB_BEGIN)
string(SUBSTRING "${M1_SOURCE_AUDIT}" ${M1_PUB_BEGIN} -1 M1_PUB_AUDIT)
string(FIND "${M1_SOURCE_SEAL}" "void packPublication(){" M1_PACK_BEGIN)
string(FIND "${M1_SOURCE_SEAL}" "void sealCompletion(){" M1_PACK_END)
math(EXPR M1_PACK_LENGTH "${M1_PACK_END}-${M1_PACK_BEGIN}")
string(SUBSTRING "${M1_SOURCE_SEAL}" ${M1_PACK_BEGIN} ${M1_PACK_LENGTH} M1_PACK)
string(REPLACE "void main(){" "void candidateMain(){" M1_QCOMMIT "${M1_QUANTUM}")
string(REPLACE "W[3]=W[1]+1u;" "W[3]=uPass==23u?W[28]:W[1]+1u;" M1_QCOMMIT "${M1_QCOMMIT}")
foreach(M1_TEXT M1_quantum_replay.glsl M1_quantum_geometry_audit.glsl M1_quantum_seal.glsl)
 string(APPEND M1_QCOMMIT "\n${${M1_TEXT}}")
endforeach()
string(REPLACE "if(W[S]==4u)" "if(W[0]!=0u)" M1_PACK "${M1_PACK}")
set(M1_QPUB_AUDIT "${M1_PUB_AUDIT}")
string(REPLACE "if(W[S]==4u)" "if(W[0]!=0u)" M1_QPUB_AUDIT "${M1_QPUB_AUDIT}")
string(REPLACE "W[S+15u]|=512u;return W[S+15u]==1023u;" "W[18]|=512u;return W[18]==1023u;" M1_QPUB_AUDIT "${M1_QPUB_AUDIT}")
string(APPEND M1_QCOMMIT "\n${M1_PACK}\n${M1_QPUB_AUDIT}\n${M1_quantum_commit_main.glsl}")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/m1/source_core.comp" M1_FSOURCE)
string(REPLACE "\r\n" "\n" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "/* INTEGER_PRIMITIVES */" "${GRS_PRIMITIVES}" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "/* SOURCE_SEAL */" "${M1_SOURCE_SEAL}" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "/* SOURCE_AUDIT */" "${M1_full_source_audit.glsl}${M1_PUB_AUDIT}" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "W[T+1u]=reason;}" "W[T+1u]=reason;W[T+4u]=W[S+2u];}" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "births>0u&&(next==0u||" "births>0u&&(next==0u||(kind==1u&&C[uHeader+127u]!=0u)||" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "=next+births;if(next+births==0u)" "=kind==1u&&next+births==0u?0xffffffffu:next+births;if(next+births==0u)" M1_FSOURCE "${M1_FSOURCE}")
string(REPLACE "=next+rows;if(next+rows==0u)" "=kind==1u&&next+rows==0u?0xffffffffu:next+rows;if(next+rows==0u)" M1_FSOURCE "${M1_FSOURCE}")
string(SHA256 M1_FULL_SHA "${M1_FSOURCE}\n${M1_QCOMMIT}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/full_m1_kernels.h" "#pragma once\nstatic constexpr const char* kM1FullSource=R\"M1FS(${M1_FSOURCE})M1FS\";\nstatic constexpr const char* kM1QuantumCommit=R\"M1QC(${M1_QCOMMIT})M1QC\";\nstatic constexpr const char* kM1FullSha=\"${M1_FULL_SHA}\";\n")
