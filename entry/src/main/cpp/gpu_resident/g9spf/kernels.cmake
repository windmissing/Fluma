set(G9_PIPELINE_FILE "${CMAKE_CURRENT_SOURCE_DIR}/g9spf/pipeline.comp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${G9_PIPELINE_FILE}")
file(READ "${G9_PIPELINE_FILE}" G9_PIPELINE)
string(REPLACE "\r\n" "\n" G9_PIPELINE "${G9_PIPELINE}")
string(SHA256 G9_PIPELINE_SHA "${G9_PIPELINE}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/g9spf_kernel.h" "#pragma once\nstatic constexpr const char* kG9Pipeline=R\"G9SPF(${G9_PIPELINE})G9SPF\";\nstatic constexpr const char* kG9PipelineHash=\"${G9_PIPELINE_SHA}\";\n")
set(G9_SCENE_HEADER "#pragma once\n")
foreach(G9_PAIR "g9spf/scene.vert|kG9SceneVertex" "g9spf/scene.frag|kG9SceneFragment" "g9spf/packet.vert|kG9PacketVertex" "g9spf/packet.frag|kG9PacketFragment")
 string(REPLACE "|" ";" G9_PARTS "${G9_PAIR}")
 list(GET G9_PARTS 0 G9_FILE)
 list(GET G9_PARTS 1 G9_SYMBOL)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${G9_FILE}")
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${G9_FILE}" G9_TEXT)
 string(REPLACE "\r\n" "\n" G9_TEXT "${G9_TEXT}")
 string(APPEND G9_SCENE_HEADER "static constexpr const char* ${G9_SYMBOL}=R\"G9SC(${G9_TEXT})G9SC\";\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/g9spf_scene.h" "${G9_SCENE_HEADER}")
target_sources(grs_foundation PRIVATE g9spf/kernel_assets.cpp g9spf/transport.cpp g9spf/completion_gate.cpp g9spf/progress_clock_v3.cpp g9spf/planning_control.cpp g9spf/quota_snapshot_v3.cpp g9spf/quota_reader_v3.cpp g9spf/controller.cpp g9spf/controller_cold.cpp g9spf/cold_capture.cpp g9spf/scene.cpp g9spf/stage_capability.cpp)
