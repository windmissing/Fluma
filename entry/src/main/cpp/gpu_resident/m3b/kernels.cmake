# Independently versioned M3 assets. Existing routes do not create this program.
set(M3_TEMPLATE "${CMAKE_CURRENT_SOURCE_DIR}/m3b/source_v5.comp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${M3_TEMPLATE}")
file(READ "${M3_TEMPLATE}" M3_SOURCE)
string(REPLACE "\r\n" "\n" M3_SOURCE "${M3_SOURCE}")
string(REGEX MATCHALL "/\\* [A-Za-z0-9_/]+\\.glsl \\*/" M3_MARKERS "${M3_SOURCE}")
foreach(M3_MARKER IN LISTS M3_MARKERS)
 string(REGEX REPLACE "^/\\* | \\*/$" "" M3_FILE "${M3_MARKER}")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}")
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}" M3_FRAGMENT)
 string(REPLACE "\r\n" "\n" M3_FRAGMENT "${M3_FRAGMENT}")
 string(REPLACE "${M3_MARKER}" "${M3_FRAGMENT}" M3_SOURCE "${M3_SOURCE}")
endforeach()
string(SHA256 M3_SOURCE_SHA "${M3_SOURCE}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/m3b_source_kernel.h" "#pragma once\nstatic constexpr const char* kM3bSource=R\"M3AV5(${M3_SOURCE})M3AV5\";\nstatic constexpr const char* kM3bSourceSha=\"${M3_SOURCE_SHA}\";\n")
target_sources(grs_foundation PRIVATE m3b/init_diagnostics.cpp m3b/kernel_assets.cpp m3b/transport.cpp m3b/controller.cpp m3b/root_owner.cpp m3b/progress_clock_v3.cpp m3b/planning_control.cpp m3b/completion_gate.cpp m3b/quota_snapshot_v3.cpp m3b/quota_reader_v3.cpp m3b/cold_capture.cpp)
set(M3_TEMPLATE "${CMAKE_CURRENT_SOURCE_DIR}/m3b/quantum_v5.comp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${M3_TEMPLATE}")
file(READ "${M3_TEMPLATE}" M3_QUANTUM)
string(REPLACE "\r\n" "\n" M3_QUANTUM "${M3_QUANTUM}")
string(REGEX MATCHALL "/\\* [A-Za-z0-9_/]+\\.glsl \\*/" M3_MARKERS "${M3_QUANTUM}")
foreach(M3_MARKER IN LISTS M3_MARKERS)
 string(REGEX REPLACE "^/\\* | \\*/$" "" M3_FILE "${M3_MARKER}")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}")
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}" M3_FRAGMENT)
 string(REPLACE "\r\n" "\n" M3_FRAGMENT "${M3_FRAGMENT}")
 string(REPLACE "${M3_MARKER}" "${M3_FRAGMENT}" M3_QUANTUM "${M3_QUANTUM}")
endforeach()
string(SHA256 M3_QUANTUM_SHA "${M3_QUANTUM}")
string(SHA256 M3_ROOT_SHA "${M3_SOURCE}\n${M3_QUANTUM}\nM3_OPCODE_SPECIALIZATION_0_18")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/m3b_root_sha.h" "#pragma once\nstatic constexpr const char* kM3bRootSha=\"${M3_ROOT_SHA}\";\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/m3b_quantum_kernel.h" "#pragma once\nstatic constexpr const char* kM3bQuantum=R\"M3QV5(${M3_QUANTUM})M3QV5\";\nstatic constexpr const char* kM3bQuantumSha=\"${M3_QUANTUM_SHA}\";\n")
set(M3_SCENE_HEADER "#pragma once\n")
foreach(M3_PAIR "m0_scene_full.vert|kM3FullVertex" "m3b/scene.frag|kM3SceneFragment" "m3b/particle.vert|kM3ParticleVertex" "m3b/particle.frag|kM3ParticleFragment" "m1/water_glyph.vert|kM3WaterVertex" "m1/water_glyph.frag|kM3WaterFragment")
 string(REPLACE "|" ";" M3_PARTS "${M3_PAIR}")
 list(GET M3_PARTS 0 M3_FILE)
 list(GET M3_PARTS 1 M3_SYMBOL)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}")
 file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${M3_FILE}" M3_TEXT)
 string(REPLACE "\r\n" "\n" M3_TEXT "${M3_TEXT}")
 string(REPLACE "#version 300 es" "#version 310 es" M3_TEXT "${M3_TEXT}")
 string(APPEND M3_SCENE_HEADER "static constexpr const char* ${M3_SYMBOL}=R\"M3SC(${M3_TEXT})M3SC\";\n")
endforeach()
string(SHA256 M3_SCENE_SHA "${M3_SCENE_HEADER}")
string(APPEND M3_SCENE_HEADER "static constexpr const char* kM3SceneSha=\"${M3_SCENE_SHA}\";\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/m3b_scene_sources.h" "${M3_SCENE_HEADER}")
target_sources(grs_foundation PRIVATE m3b/scene.cpp)

file(GLOB M5_INIT_INPUTS CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/m3b/*.inc" "${CMAKE_CURRENT_SOURCE_DIR}/m3b/init_*" "${CMAKE_CURRENT_SOURCE_DIR}/program_cache/program_observer.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${M5_INIT_INPUTS})
