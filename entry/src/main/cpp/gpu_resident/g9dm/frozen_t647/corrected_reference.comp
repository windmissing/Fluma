// floating-point intermediary. All faulting operations leave out=0.
bool g9Zero(uvec4 a){return all(equal(a,uvec4(0u)));}
bool g9Negative(uvec4 a){return (a.w&0x80000000u)!=0u;}
uvec4 g9U32(uint a){return uvec4(a,0u,0u,0u);}
uvec4 g9S32(int a){uint sign=a<0?0xffffffffu:0u;return uvec4(uint(a),sign,sign,sign);}
uvec4 g9U64(uvec2 a){return uvec4(a,0u,0u);}
uvec4 g9S64(uvec2 a){uint sign=(a.y&0x80000000u)!=0u?0xffffffffu:0u;return uvec4(a,sign,sign);}
int g9UCmp(uvec4 a,uvec4 b){for(int i=3;i>=0;--i)if(a[i]!=b[i])return a[i]<b[i]?-1:1;return 0;}
int g9SCmp(uvec4 a,uvec4 b){if(g9Negative(a)!=g9Negative(b))return g9Negative(a)?-1:1;return g9UCmp(a,b);}
uvec4 g9AddBits(uvec4 a,uvec4 b,out uint carry){
 uvec4 result;carry=0u;for(int i=0;i<4;++i){uint c0,c1;uint sum=uaddCarry(a[i],b[i],c0);result[i]=uaddCarry(sum,carry,c1);carry=c0|c1;}return result;
}
uvec4 g9NegBits(uvec4 a){uint carry;return g9AddBits(~a,g9U32(1u),carry);}
bool g9UAdd(uvec4 a,uvec4 b,out uvec4 result){uint carry;result=g9AddBits(a,b,carry);if(carry!=0u){result=uvec4(0u);return false;}return true;}
bool g9USub(uvec4 a,uvec4 b,out uvec4 result){result=uvec4(0u);if(g9UCmp(a,b)<0)return false;uint carry;result=g9AddBits(a,g9NegBits(b),carry);return true;}
bool g9SAdd(uvec4 a,uvec4 b,out uvec4 result){uint carry;result=g9AddBits(a,b,carry);if(g9Negative(a)==g9Negative(b)&&g9Negative(result)!=g9Negative(a)){result=uvec4(0u);return false;}return true;}
bool g9SNeg(uvec4 a,out uvec4 result){result=uvec4(0u);if(all(equal(a,uvec4(0u,0u,0u,0x80000000u))))return false;result=g9NegBits(a);return true;}
bool g9SSub(uvec4 a,uvec4 b,out uvec4 result){
 // MIN is a valid subtrahend when the signed difference remains in range.
 uint carry;result=g9AddBits(a,g9NegBits(b),carry);if(g9Negative(a)!=g9Negative(b)&&g9Negative(result)!=g9Negative(a)){result=uvec4(0u);return false;}return true;
}
uvec4 g9Magnitude(uvec4 a){return g9Negative(a)?g9NegBits(a):a;}
bool g9FromMagnitude(uvec4 magnitude,bool negative,out uvec4 result){
 result=uvec4(0u);const uvec4 minMagnitude=uvec4(0u,0u,0u,0x80000000u);int cmp=g9UCmp(magnitude,minMagnitude);
 if(cmp>0||!negative&&cmp==0)return false;result=negative&&!g9Zero(magnitude)?g9NegBits(magnitude):magnitude;return true;
}
bool g9UMul(uvec4 a,uvec4 b,out uvec4 result){
 uint aa[8],bb[8],digits[16];for(int i=0;i<8;++i){aa[i]=(a[i/2]>>uint(16*(i%2)))&65535u;bb[i]=(b[i/2]>>uint(16*(i%2)))&65535u;}
 for(int i=0;i<16;++i)digits[i]=0u;
 for(int i=0;i<8;++i){uint carry=0u;for(int j=0;j<8;++j){uint n=digits[i+j]+aa[i]*bb[j]+carry;digits[i+j]=n&65535u;carry=n>>16u;}digits[i+8]=carry;}
 result=uvec4(0u);for(int i=8;i<16;++i)if(digits[i]!=0u)return false;
 for(int i=0;i<4;++i)result[i]=digits[2*i]|(digits[2*i+1]<<16u);return true;
}
bool g9SMul(uvec4 a,uvec4 b,out uvec4 result){uvec4 magnitude;if(!g9UMul(g9Magnitude(a),g9Magnitude(b),magnitude)){result=uvec4(0u);return false;}return g9FromMagnitude(magnitude,g9Negative(a)!=g9Negative(b),result);}
bool g9UShift(uvec4 a,uint n,out uvec4 result){
 result=uvec4(0u);if(n>=128u)return g9Zero(a);
 for(int bit=127;bit>=0;--bit)if(((a[bit/32]>>uint(bit%32))&1u)!=0u){uint target=uint(bit)+n;if(target>=128u){result=uvec4(0u);return false;}result[int(target/32u)]|=1u<<(target%32u);}return true;
}
bool g9SShift(uvec4 a,uint n,out uvec4 result){uvec4 magnitude;if(!g9UShift(g9Magnitude(a),n,magnitude)){result=uvec4(0u);return false;}return g9FromMagnitude(magnitude,g9Negative(a),result);}
bool g9UDiv(uvec4 numerator,uvec4 denominator,out uvec4 quotient,out uvec4 remainder){
 quotient=remainder=uvec4(0u);if(g9Zero(denominator))return false;
 for(int bit=127;bit>=0;--bit){uint high=remainder.w>>31u;remainder=uvec4(remainder.x<<1u,(remainder.y<<1u)|(remainder.x>>31u),(remainder.z<<1u)|(remainder.y>>31u),(remainder.w<<1u)|(remainder.z>>31u));remainder.x|=(numerator[bit/32]>>uint(bit%32))&1u;
  if(high!=0u||g9UCmp(remainder,denominator)>=0){uint carry;remainder=g9AddBits(remainder,g9NegBits(denominator),carry);quotient[bit/32]|=1u<<uint(bit%32);}
 }return true;
}
// rounding: 0 TZ, 1 nearest-even, 2 floor, 3 ceil.
bool g9SDiv(uvec4 numerator,uvec4 denominator,uint rounding,out uvec4 result){
 result=uvec4(0u);uvec4 q,r;uvec4 d=g9Magnitude(denominator);bool negative=g9Negative(numerator)!=g9Negative(denominator);
 if(!g9UDiv(g9Magnitude(numerator),d,q,r))return false;
 bool increase=false;if(!g9Zero(r)){
  if(rounding==1u){uvec4 complement;if(!g9USub(d,r,complement))return false;int cmp=g9UCmp(r,complement);increase=cmp>0||cmp==0&&(q.x&1u)!=0u;}
  else increase=rounding==2u&&negative||rounding==3u&&!negative;
 }
 if(increase&&!g9UAdd(q,g9U32(1u),q))return false;return g9FromMagnitude(q,negative,result);
}
bool g9I32(uvec4 a,out int result){uint sign=(a.x&0x80000000u)!=0u?0xffffffffu:0u;result=0;if(a.y!=sign||a.z!=sign||a.w!=sign)return false;result=int(a.x);return true;}
bool g9I64(uvec4 a,out uvec2 result){uint sign=(a.y&0x80000000u)!=0u?0xffffffffu:0u;result=uvec2(0u);if(a.z!=sign||a.w!=sign)return false;result=a.xy;return true;}
bool g9Uint(uvec4 a,out uint result){result=0u;if(any(notEqual(a.yzw,uvec3(0u))))return false;result=a.x;return true;}
bool g9CeilSqrt64(uvec2 raw,out uint result){
 uvec4 n=g9U64(raw);uint low=0u,high=0xffffffffu;
 for(uint iteration=0u;iteration<32u;++iteration){uint middle=low+(high-low)/2u;uvec4 square;if(!g9UMul(g9U32(middle),g9U32(middle),square))return false;if(g9UCmp(square,n)<0)low=middle+1u;else high=middle;}
 uvec4 square;if(!g9UMul(g9U32(low),g9U32(low),square)||g9UCmp(square,n)<0)return false;result=low;return true;
}
struct G9EnergyInterval {uvec4 low;uvec4 high;};
bool g9FlowKinetic(uvec2 momentum,uint mass,out G9EnergyInterval result){
 result.low=result.high=uvec4(0u);uvec4 p=g9Magnitude(g9S64(momentum));if(mass==0u)return g9Zero(p);
 uvec4 square,q,r,fraction,rest;if(!g9UMul(p,p,square)||!g9UDiv(square,g9U32(mass),q,r)||!g9UShift(q,24u,q)||!g9UShift(r,24u,r)||!g9UDiv(r,g9U32(mass),fraction,rest)||!g9UAdd(q,fraction,result.low))return false;
 result.high=result.low;if(!g9Zero(rest)&&!g9UAdd(result.high,g9U32(1u),result.high))return false;return !g9Negative(result.high);
}

// Five complete banks are selected by the owner, four SSBOs per pass.
layout(std430,binding=0)readonly buffer ReadState{uint B[];};
layout(std430,binding=1)coherent buffer WriteState{uint C[];};
layout(std430,binding=2)coherent buffer Workspace{uint W[];};
layout(std430,binding=3)coherent buffer EventPath{uint E[];};
uniform uint uK,uStateWords,uColumn,uBed,uFlow,uPacket,uSources;
uniform uint uInput,uConfig,uControls,uSummary,uStageDiagnostic,uOriginAudit,uColumnStage,uHamilton,uContacts,uFaces,uWideLedger,uCompletion;
uniform uint uRootKind,uRequiredAudits;
uniform uint uOp,uRole,uJslot,uMicro,uPass,uRequiredPasses,uEventCapacity,uPathCapacity,uPathWord;
uint uJ;
uniform uvec2 uNonce,uRun,uOwner,uContext,uSurface,uGeometry,uConfigId,uInputGeneration,uSession,uPlan,uBaseCommit;
uniform uint uCandidateBank,uBaseBank,uArena;
uniform uvec2 uArenaGeneration;
uniform int uAcceptedAngle,uAngleSin,uAngleCos;
uint g9Ctl(uint field){return W[uControls+field];}
void g9Set(uint field,uint value){W[uControls+field]=value;}
// Controls: 0 fatal,1 reason,2 stage,3 micro,4 entity,5 operand,
// 6 event planned,7 event sealed,8 path planned,9 path sealed,
// 10 compound pending,11 selectedJ,12 eligibleJ,13 selected trial,
// 14 current trial reason,15 current outcome,16 executed dispatch,
// 17 audit mask,18 source/impulse duplicate,19 stage cursor.
void g9Fault(uint reason,uint entity,uint operand){
 if(g9Ctl(0u)!=0u)return;g9Set(0u,1u);g9Set(1u,reason);g9Set(2u,uOp);g9Set(3u,uMicro);g9Set(4u,entity);g9Set(5u,operand);g9Set(15u,5u);
}
void g9Reject(uint reason,uint entity,uint operand){
 if(g9Ctl(0u)!=0u||g9Ctl(14u)!=0u)return;
 // A normal rejected private compound retains only the last sealed prefix.
 g9Set(6u,g9Ctl(7u));g9Set(8u,g9Ctl(9u));g9Set(10u,0u);
 g9Set(14u,reason);g9Set(2u,uOp);g9Set(3u,uMicro);g9Set(4u,entity);g9Set(5u,operand);
}
uint g9Column(uint c,uint field){return C[uColumn+c*32u+field];}
void g9PutColumn(uint c,uint field,uint value){C[uColumn+c*32u+field]=value;}
uint g9Packet(uint slot,uint field){return C[uPacket+slot*64u+field];}
void g9PutPacket(uint slot,uint field,uint value){C[uPacket+slot*64u+field]=value;}
uvec4 g9Momentum(uint c){return g9S64(uvec2(g9Column(c,2u),g9Column(c,3u)));}
bool g9PutMomentum(uint c,uvec4 p){uvec2 narrow;if(!g9I64(p,narrow)){g9Fault(29u,c,2u);return false;}g9PutColumn(c,2u,narrow.x);g9PutColumn(c,3u,narrow.y);g9PutColumn(c,4u,g9Zero(p)?0u:1u);return true;}
uvec4 g9ReadWide(uint at){return uvec4(W[at],W[at+1u],W[at+2u],W[at+3u]);}
void g9WriteWide(uint at,uvec4 value){for(uint i=0u;i<4u;++i)W[at+i]=value[i];}
uvec4 g9HeaderWide(uint at){return uvec4(C[at],C[at+1u],C[at+2u],C[at+3u]);}
bool g9Accumulate(uint header,uvec4 delta){uvec4 next;if(!g9SAdd(g9HeaderWide(header),delta,next)){g9Fault(29u,0u,header);return false;}for(uint i=0u;i<4u;++i)C[header+i]=next[i];return true;}
uint g9Material(uint c){return g9Column(c,0u)+g9Column(c,1u);}
uint g9Occupied(uint c){return g9Material(c)+g9Column(c,8u);}
void g9Derived(uint c){g9PutColumn(c,9u,g9Material(c));}
bool g9AddMass(uint a,uint b,out uint result){result=0u;if(a>268435456u||b>268435456u-a)return false;result=a+b;return true;}
bool g9Reserve(uint events,uint paths,out uint eventStart,out uint pathStart){
 eventStart=g9Ctl(6u);pathStart=g9Ctl(8u);
 if(g9Ctl(10u)!=0u||eventStart>uEventCapacity||events>uEventCapacity-eventStart||pathStart>uPathCapacity||paths>uPathCapacity-pathStart){g9Fault(27u,0u,0u);return false;}
 g9Set(6u,eventStart+events);g9Set(8u,pathStart+paths);g9Set(10u,1u);return true;
}
void g9Event(out uint row[64],uint kind,uint entity,uint from,uint to){
 for(uint i=0u;i<64u;++i)row[i]=0u;
 row[0]=G9_EVENT_MAGIC;row[1]=2u;row[2]=kind;row[3]=g9Ctl(13u);row[4]=uNonce.x;row[5]=uNonce.y;row[6]=g9Ctl(7u)+1u;row[7]=uOp==G9_OP_SOURCE_AUDIT_REPLAY?G9_OP_SOURCE_PRIVATE_BIRTH:uOp;row[8]=uMicro;
 row[9]=from;row[10]=to;row[11]=entity;row[14]=(uRole==4u?2u:uRole==2u?1u:0u);row[63]=G9_SEAL;
}
bool g9WriteEvent(uint at,uint row[64]){
 if(at>=g9Ctl(6u)){g9Fault(27u,0u,at);return false;}
 uvec2 mask=g9EventMask(row[2]);if(all(equal(mask,uvec2(0u)))){g9Fault(23u,0u,row[2]);return false;}
 if(uOp==G9_OP_SOURCE_AUDIT_REPLAY){
  for(uint i=0u;i<64u;++i){uint expected=((mask[i/32u]>>(i%32u))&1u)!=0u?row[i]:0u;if(E[at*64u+i]!=expected){g9Fault(25u,at,i);return false;}}return true;
 }
 for(uint i=0u;i<63u;++i)E[at*64u+i]=(((mask[i/32u]>>(i%32u))&1u)!=0u?row[i]:0u);
 memoryBarrierBuffer();E[at*64u+63u]=G9_SEAL;return true;
}
bool g9Seal(){
 if(g9Ctl(0u)!=0u||g9Ctl(14u)!=0u||g9Ctl(10u)==0u)return false;
 g9Set(7u,g9Ctl(6u));g9Set(9u,g9Ctl(8u));g9Set(10u,0u);return true;
}
bool g9OneEvent(uint row[64]){uint event,path;return g9Reserve(1u,0u,event,path)&&g9WriteEvent(event,row)&&g9Seal();}

// Bed: bottom-to-top stack. Flow: sorted uniformly mixed sparse map.
uint g9MapAddress(bool flow,uint column,uint rank){return (flow?uFlow:uBed)+(column*64u+rank)*4u;}
uvec3 g9Key(bool flow,uint column,uint rank){uint at=g9MapAddress(flow,column,rank);return uvec3(C[at],C[at+1u],C[at+2u]);}
int g9KeyCompare(uvec3 a,uvec3 b){if(a.y!=b.y)return a.y<b.y?-1:1;if(a.x!=b.x)return a.x<b.x?-1:1;return a.z==b.z?0:a.z<b.z?-1:1;}
bool g9KeyValid(uvec3 key){if(key.x==0u||key.x>C[19u]||key.y!=0u||key.z==0u)return false;uint at=uSources+(key.x-1u)*16u;return C[at]==key.x&&C[at+1u]==0u&&C[at+2u]==key.z;}
uint g9MapCount(bool flow,uint c){return g9Column(c,flow?7u:6u);}
void g9SetMapCount(bool flow,uint c,uint n){g9PutColumn(c,flow?7u:6u,n);}
bool g9MapCanAdd(bool flow,uint c,uvec3 key){
 uint count=g9MapCount(flow,c);if(count>64u)return false;
 if(!flow)return count==0u||g9KeyCompare(g9Key(false,c,count-1u),key)==0||count<64u;
 for(uint i=0u;i<count;++i)if(g9KeyCompare(g9Key(true,c,i),key)==0)return true;return count<64u;
}
bool g9MapAdd(bool flow,uint c,uvec3 key,uint q){
 if(q==0u||!g9KeyValid(key)||!g9MapCanAdd(flow,c,key))return false;
 uint count=g9MapCount(flow,c),rank=count;
 if(!flow&&count>0u&&g9KeyCompare(g9Key(false,c,count-1u),key)==0)rank=count-1u;
 if(flow)for(uint i=0u;i<count;++i){int cmp=g9KeyCompare(g9Key(true,c,i),key);if(cmp>=0){rank=i;break;}}
 bool merge=rank<count&&g9KeyCompare(g9Key(flow,c,rank),key)==0;
 if(merge){uint at=g9MapAddress(flow,c,rank),next;if(!g9AddMass(C[at+3u],q,next))return false;C[at+3u]=next;return true;}
 for(uint i=count;i>rank;--i)for(uint f=0u;f<4u;++f)C[g9MapAddress(flow,c,i)+f]=C[g9MapAddress(flow,c,i-1u)+f];
 uint at=g9MapAddress(flow,c,rank);C[at]=key.x;C[at+1u]=key.y;C[at+2u]=key.z;C[at+3u]=q;g9SetMapCount(flow,c,count+1u);return true;
}
bool g9MapTake(bool flow,uint c,uint rank,uint q){
 uint count=g9MapCount(flow,c);if(rank>=count||count>64u||q==0u)return false;
 uint at=g9MapAddress(flow,c,rank),mass=C[at+3u];if(q>mass)return false;
 if(q<mass){C[at+3u]=mass-q;return true;}
 for(uint i=rank;i+1u<count;++i)for(uint f=0u;f<4u;++f)C[g9MapAddress(flow,c,i)+f]=C[g9MapAddress(flow,c,i+1u)+f];
 for(uint f=0u;f<4u;++f)C[g9MapAddress(flow,c,count-1u)+f]=0u;g9SetMapCount(flow,c,count-1u);return true;
}
// Preflight a whole S->F conversion in the already-budgeted Hamilton scratch.
bool g9RecruitPreflight(uint c,uint q){
 uint bed=g9Column(c,0u),depth=g9MapCount(false,c),flowCount=g9MapCount(true,c);if(q>bed||depth>64u||flowCount>64u)return false;
 uint newCount=flowCount;
 for(uint n=0u;n<depth&&q>0u;++n){uint rank=depth-1u-n;uvec3 key=g9Key(false,c,rank);bool found=false;
  for(uint i=0u;i<flowCount;++i)if(g9KeyCompare(key,g9Key(true,c,i))==0)found=true;
  for(uint i=0u;i<n&&!found;++i)if(g9KeyCompare(key,g9Key(false,c,depth-1u-i))==0)found=true;
  if(!found&&++newCount>64u)return false;uint amount=min(q,C[g9MapAddress(false,c,rank)+3u]);q-=amount;
 }return q==0u;
}
bool g9RecruitMap(uint c,uint q){
 if(!g9RecruitPreflight(c,q))return false;
 uint left=q;for(uint i=0u;i<64u&&left>0u;++i){uint rank=g9MapCount(false,c)-1u;uvec3 key=g9Key(false,c,rank);uint amount=min(left,C[g9MapAddress(false,c,rank)+3u]);
  if(!g9MapTake(false,c,rank,amount)||!g9MapAdd(true,c,key,amount))return false;left-=amount;
 }return left==0u;
}
bool g9DepositPreflight(uint c){
 uint depth=g9MapCount(false,c),count=g9MapCount(true,c);if(depth>64u||count>64u)return false;
 uvec3 top=depth==0u?uvec3(0u):g9Key(false,c,depth-1u);
 for(uint i=0u;i<count;++i){uvec3 key=g9Key(true,c,i);if(depth==0u||g9KeyCompare(top,key)!=0){if(depth==64u)return false;++depth;top=key;}}return true;
}
bool g9DepositMap(uint c){
 if(!g9DepositPreflight(c))return false;
 uint count=g9MapCount(true,c);for(uint i=0u;i<count;++i){uint at=g9MapAddress(true,c,i);if(!g9MapAdd(false,c,g9Key(true,c,i),C[at+3u]))return false;}
 for(uint i=0u;i<64u*4u;++i)C[uFlow+c*256u+i]=0u;g9SetMapCount(true,c,0u);return true;
}
// Left then right callers consume the remaining map, never the original M.
bool g9Hamilton(uint donor,uint q,uint scratch){
 uint mass=g9Column(donor,1u),count=g9MapCount(true,donor);if(q>mass||mass==0u||count>64u)return false;uint sum=0u;
 for(uint i=0u;i<count;++i){uint at=g9MapAddress(true,donor,i);uvec4 product,quotient,remainder;
  if(!g9UMul(g9U32(q),g9U32(C[at+3u]),product)||!g9UDiv(product,g9U32(mass),quotient,remainder))return false;
  W[scratch+i*4u]=quotient.x;W[scratch+i*4u+1u]=remainder.x;W[scratch+i*4u+2u]=0u;sum+=quotient.x;
 }
 for(uint n=0u;n<q-sum;++n){uint best=count;for(uint i=0u;i<count;++i)if(W[scratch+i*4u+2u]==0u&&(best==count||W[scratch+i*4u+1u]>W[scratch+best*4u+1u]))best=i;
  if(best==count)return false;W[scratch+best*4u]++;W[scratch+best*4u+2u]=1u;
 }return true;
}

bool g9IntervalAdd(G9EnergyInterval a,G9EnergyInterval b,out G9EnergyInterval result){return g9SAdd(a.low,b.low,result.low)&&g9SAdd(a.high,b.high,result.high);}
bool g9IntervalSubtract(G9EnergyInterval after,G9EnergyInterval before,out G9EnergyInterval result){return g9SSub(after.low,before.high,result.low)&&g9SSub(after.high,before.low,result.high);}
G9EnergyInterval g9Exact(uvec4 value){G9EnergyInterval result;result.low=result.high=value;return result;}
bool g9ColumnPotential(uint c,uint bed,uint flow,out uvec4 potential){
 uvec4 x=g9U32(c*1048576u+524288u),gx=g9S32(int(C[22u])),gn=g9U32(C[23u]);
 uvec4 total=g9U32(bed+flow),horizontal,vertical,inside;
 if(!g9SMul(gx,x,horizontal)||!g9SShift(horizontal,1u,horizontal)||!g9SMul(gn,total,vertical)||!g9SSub(vertical,horizontal,inside)||!g9SMul(total,inside,potential)||!g9SShift(potential,24u,potential))return false;
 return true; // U_bed+U_flow = (S+F)*(gn*(S+F)-2gx*x).
}
bool g9PacketEnergy(uint mass,uint x,uint y2,int vx,int vy,out uvec4 result){
 uvec4 xx,yy,kinetic,potential,horizontal;
 if(!g9SMul(g9S32(vx),g9S32(vx),xx)||!g9SMul(g9S32(vy),g9S32(vy),yy)||!g9SAdd(xx,yy,kinetic)||
    !g9SMul(g9U32(C[23u]),g9U32(y2),potential)||!g9SMul(g9S32(int(C[22u])),g9U32(x),horizontal)||!g9SShift(horizontal,1u,horizontal)||
    !g9SSub(potential,horizontal,potential)||!g9SAdd(kinetic,potential,result)||!g9SMul(result,g9U32(mass),result)||!g9SShift(result,24u,result))return false;
 return true;
}
bool g9ColumnEnergy(uint c,out G9EnergyInterval result){
 uvec4 potential;G9EnergyInterval kinetic;if(!g9ColumnPotential(c,g9Column(c,0u),g9Column(c,1u),potential)||!g9FlowKinetic(uvec2(g9Column(c,2u),g9Column(c,3u)),g9Column(c,1u),kinetic))return false;
