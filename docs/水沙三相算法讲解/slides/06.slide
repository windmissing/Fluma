<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(160deg, #0F2A43 0%, #1D4E79 100%)', padding: '20px 60px', flexDirection: 'column' }}>
    <Box style={{ height: 100, justifyContent: 'center' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>三相守恒：方案的地基</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        {/* 左：巨型数字 */}
        <Box style={{ width: 460, flexDirection: 'column', gap: 14, alignItems: 'center' }}>
            <Text style={{ fontSize: 132, fontWeight: 'bold', color: '#F39C12', lineHeight: 1 }}>0.1%</Text>
            <Text style={{ fontSize: 24, color: '#C8D8E6', textAlign: 'center', lineHeight: 1.6 }}>
                全程允许的重沙/轻沙/水<br />最大漂移量——硬性验收线
            </Text>
        </Box>
        {/* 右：守恒环 SVG */}
        <Box style={{ flex: 1, background: 'rgba(255,255,255,0.06)', borderRadius: 16, padding: 20 }}>
            <svg width={640} height={440} viewBox='0 0 640 440'>
                <text x={320} y={30} fill='#FFFFFF' fontSize={20} fontWeight='bold' textAnchor='middle'>任何操作前后，三个总量必须原封不动</text>
                {/* 三个守恒量圆环 */}
                {[
                    { cx: 140, cy: 150, label: '重沙 VH', c: '#F39C12' },
                    { cx: 320, cy: 150, label: '轻沙 VL', c: '#E8D8A0' },
                    { cx: 500, cy: 150, label: '水 Vw', c: '#7FB3D5' },
                ].map((r) => (
                    <g key={r.cx}>
                        <circle cx={r.cx} cy={r.cy} r={70} fill='none' stroke={r.c} strokeWidth={5} />
                        <text x={r.cx} y={r.cy + 8} fill={r.c} fontSize={26} fontWeight='bold' textAnchor='middle'>{r.label}</text>
                    </g>
                ))}
                {/* 中间等号 */}
                <text x={320} y={272} fill='#C8D8E6' fontSize={22} textAnchor='middle'>操作前 = 操作后（每个子步都验一遍）</text>
                {/* 底部解释 */}
                <rect x={40} y={300} width={560} height={110} rx={12} fill='rgba(243,156,18,0.12)' stroke='#F39C12' strokeWidth={1.5} />
                <text x={320} y={338} fill='#F39C12' fontSize={19} fontWeight='bold' textAnchor='middle'>沉降、分选、滑移、扬起、倒立——每一个动作</text>
                <text x={320} y={370} fill='#C8D8E6' fontSize={18} textAnchor='middle'>都要先证明「进出相抵」，才允许写进代码</text>
            </svg>
        </Box>
    </Box>
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 12, height: 12, background: '#F39C12' }} />
            <Text style={{ fontSize: 14, color: '#5D6D7E' }}>水沙三相算法 · HelloWorld</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#5D6D7E' }}>06 / 14</Text>
    </Box>
</Slide>
