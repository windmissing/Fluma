    {/* 坐标纸网格纹样 */}
    <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', top: 0, left: 0, opacity: 0.10 }}>
        {[64, 128, 192, 256, 320, 384, 448, 512, 576, 640, 704, 768, 832, 896, 960, 1024, 1088, 1152, 1216].map((x) => (
            <line key={'v'+x} x1={x} y1={0} x2={x} y2={720} stroke='#7FB3D5' strokeWidth={1} />
        ))}
        {[60, 120, 180, 240, 300, 360, 420, 480, 540, 600, 660].map((y) => (
            <line key={'h'+y} x1={0} y1={y} x2={1280} y2={y} stroke='#7FB3D5' strokeWidth={1} />
        ))}
    </svg>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 720, justifyContent: 'center', alignItems: 'center', flexDirection: 'column', gap: 28 }}>
        <Text style={{ fontSize: 120, fontWeight: 'bold', color: '#F39C12', lineHeight: 1 }}>03</Text>
        <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#FFFFFF' }}>数字怎么验证</Text>
        <Box style={{ width: 90, height: 6, background: '#7FB3D5', borderRadius: 3 }} />
