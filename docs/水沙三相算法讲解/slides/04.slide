<Slide style={{ width: 1280, height: 720, background: '#F5F8FB', padding: '20px 60px', flexDirection: 'column' }}>
    <Box style={{ height: 100, justifyContent: 'center' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F2A43' }}>一列只有 6 个数</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 36 }}>
        {/* 左侧：列剖面 SVG */}
        <Box style={{ width: 560, background: '#FFFFFF', borderRadius: 16, padding: 16, boxShadow: '0 4px 16px rgba(15,42,67,0.10)', justifyContent: 'center', alignItems: 'center' }}>
            <svg width={520} height={440} viewBox='0 0 520 440'>
                {/* 单列放大示意：三根相邻列 */}
                <text x={20} y={26} fill='#5D6D7E' fontSize={16}>把容器切成 28 根竖列，每一列记住 6 个数：</text>
                {/* 列 1 */}
                <rect x={60} y={50} width={100} height={340} fill='#ECF2F7' stroke='#1D4E79' strokeWidth={2} rx={4} />
                {/* 水区 */}
                <rect x={62} y={62} width={96} height={180} fill='rgba(127,179,213,0.35)' />
                <line x1={62} y1={62} x2={158} y2={62} stroke='#1D4E79' strokeWidth={3} />
                <text x={170} y={68} fill='#1D4E79' fontSize={17} fontWeight='bold'>waterTop 水面高度</text>
                {/* 悬浮重沙 */}
                <circle cx={100} cy={110} r={6} fill='#F39C12' />
                <circle cx={125} cy={150} r={6} fill='#F39C12' />
                <text x={170} y={122} fill='#B06A00' fontSize={17} fontWeight='bold'>suspH 悬浮重沙</text>
                {/* 悬浮轻沙 */}
                <circle cx={95} cy={195} r={6} fill='#E8E8E8' stroke='#95A5A6' />
                <circle cx={130} cy={220} r={6} fill='#E8E8E8' stroke='#95A5A6' />
                <text x={170} y={205} fill='#5D6D7E' fontSize={17} fontWeight='bold'>suspL 悬浮轻沙</text>
                {/* 混合表层（最上） */}
                <rect x={62} y={252} width={96} height={26} fill='#D9B87C' />
                <text x={170} y={271} fill='#7A5B1E' fontSize={17} fontWeight='bold'>mh+ml 混合表层</text>
                {/* 有序轻层（中） */}
                <rect x={62} y={278} width={96} height={50} fill='#C9A15C' />
                <text x={170} y={308} fill='#6B4E1B' fontSize={17} fontWeight='bold'>bl 有序轻沙层（上）</text>
                {/* 有序重层（最下） */}
                <rect x={62} y={328} width={96} height={60} fill='#8A5A2B' />
                <text x={170} y={363} fill='#5D3A12' fontSize={17} fontWeight='bold'>bh 有序重沙层（下）</text>
                {/* 列底 */}
                <text x={98} y={415} fill='#5D6D7E' fontSize={15}>列 1</text>
                {/* 列 2 缩略 */}
                <rect x={330} y={50} width={60} height={340} fill='#ECF2F7' stroke='#1D4E79' strokeWidth={2} rx={4} />
                <rect x={332} y={90} width={56} height={150} fill='rgba(127,179,213,0.35)' />
                <rect x={332} y={260} width={56} height={20} fill='#D9B87C' />
                <rect x={332} y={280} width={56} height={40} fill='#C9A15C' />
                <rect x={332} y={320} width={56} height={68} fill='#8A5A2B' />
                <text x={348} y={415} fill='#5D6D7E' fontSize={15}>列 2</text>
                {/* 箭头省略 */}
                <text x={408} y={220} fill='#95A5A6' fontSize={22}>…</text>
                <rect x={445} y={50} width={60} height={340} fill='#ECF2F7' stroke='#1D4E79' strokeWidth={2} rx={4} />
                <rect x={447} y={70} width={56} height={170} fill='rgba(127,179,213,0.35)' />
                <rect x={447} y={250} width={56} height={24} fill='#D9B87C' />
                <rect x={447} y={274} width={56} height={46} fill='#C9A15C' />
                <rect x={447} y={320} width={56} height={68} fill='#8A5A2B' />
                <text x={463} y={415} fill='#5D6D7E' fontSize={15}>列 28</text>
            </svg>
        </Box>
        {/* 右侧文字 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 18, justifyContent: 'center' }}>
            <Text style={{ fontSize: 22, color: '#2C3E50', lineHeight: 1.65 }}>
                不是逐颗粒子——每列只记 <span style={{ color: '#1D4E79', fontWeight: 'bold' }}>6 个数</span>：
                水面高度、悬浮重沙、悬浮轻沙，以及沙堆内部的三层结构（有序重层、有序轻层、混合表层）。
            </Text>
            <Box style={{ background: 'rgba(127,179,213,0.15)', borderRadius: 12, padding: '16px 20px' }}>
                <Text style={{ fontSize: 20, color: '#2C3E50', lineHeight: 1.6 }}>
                    <span style={{ fontWeight: 'bold', color: '#1D4E79' }}>为什么够用？</span><br />
                    沙画看的是「哪层沙在哪」，不是每颗沙的轨迹。列内的垂直相序由四层账本精确记录，横向只需相邻列之间搬运。
                </Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 16 }}>
                <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: 16, boxShadow: '0 4px 16px rgba(15,42,67,0.10)', alignItems: 'center' }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1D4E79' }}>28</Text>
                    <Text style={{ fontSize: 16, color: '#5D6D7E' }}>列</Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: 16, boxShadow: '0 4px 16px rgba(15,42,67,0.10)', alignItems: 'center' }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1D4E79' }}>×6</Text>
                    <Text style={{ fontSize: 16, color: '#5D6D7E' }}>个数/列</Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: 16, boxShadow: '0 4px 16px rgba(15,42,67,0.10)', alignItems: 'center' }}>
                    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#F39C12' }}>168</Text>
                    <Text style={{ fontSize: 16, color: '#5D6D7E' }}>个数字 = 全部状态</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 12, height: 12, background: '#1D4E79' }} />
            <Text style={{ fontSize: 14, color: '#5D6D7E' }}>水沙三相算法 · HelloWorld</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#5D6D7E' }}>04 / 14</Text>
    </Box>
</Slide>
