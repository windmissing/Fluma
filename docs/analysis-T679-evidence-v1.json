  "cases": [
    {
      "id": "C01",
      "goals": [
        15,
        16,
        17,
        18,
        19
      ],
      "kind": "ownership_and_transaction",
      "criterion": "Exact authoritative integer mass/origin balance and one owner; rejection changes none of the accepted physical/visual/time state",
      "reference": "Independent inventory/event audit; no CPU physics stepping",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C02",
      "goals": [
        15,
        16,
        17
      ],
      "kind": "frame_and_input",
      "criterion": "Coordinate identities and separately derived impulse/work balance; no duplicated world moving-wall and rotating-frame forcing",
      "reference": "Analytic coordinate transformation and declared scripted motion",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C03",
      "goals": [
        15,
        16,
        17,
        18,
        19
      ],
      "kind": "capacity_and_cost",
      "criterion": "All explicit maxima accounted for; overflow rejects without truncation; timing and memory measured separately from payload estimates",
      "reference": "Offline cost formula and actual device allocation/timing records",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C04",
      "goals": [
        15,
        16,
        17,
        19
      ],
      "kind": "water_geometry_and_reaction",
      "criterion": "Same physical occupancy does not displace additional water; closed-volume compatibility and geometry-time balance; loads counted once",
      "reference": "Actual G14/G12 validated interface plus independent geometry algebra; no early release of T611/T612",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C05",
      "goals": [
        15
      ],
      "kind": "fixed_angle_sliding_subproblem",
      "criterion": "Compare a=g*(sin(theta)-mu*cos(theta)), velocity and displacement under the stated sliding assumptions; refine dt/h",
      "reference": "Analytic subproblem, not an entire collapsing heap oracle",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C06",
      "goals": [
        15
      ],
      "kind": "large_tilt_collapse",
      "criterion": "Continuous physically accepted movement and collapse/recovery against declared reference uncertainty; reaching angle alone is insufficient",
      "reference": "REFERENCE_REQUIRED for real-material claim; existing relevant physical evidence reused where applicable",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C07",
      "goals": [
        15
      ],
      "kind": "closure_and_numerical_separation",
      "criterion": "Distinguish closure, discretization, representation and visual errors using one reference/error budget; no unapproved old-profile resolution change",
      "reference": "Independent analytic or measured observables; new research identities for unsupported resolutions",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C08",
      "goals": [
        15,
        16
      ],
      "kind": "height_representation_limit",
      "criterion": "Represent the state in the selected new domain or explicitly reject as unsupported; never collapse the gap or use abs/epsilon normal gravity silently",
      "reference": "Finite geometric and unilateral-support counterexamples",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C09",
      "goals": [
        16
      ],
      "kind": "free_flight",
      "criterion": "Analytic free-flight trajectory within declared spatial/time/quantization budget; no hidden contact or second integration at conversion",
      "reference": "Analytic before-contact interval only",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C10",
      "goals": [
        16
      ],
      "kind": "fixed_and_moving_wall_contact",
      "criterion": "Analytic scalar impact impulse/energy plus declared nonpenetration tolerance; moving wall can supply work",
      "reference": "Independent finite impact formula, not a DEM time integrator",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C11",
      "goals": [
        16
      ],
      "kind": "support_release_and_recontact",
      "criterion": "No tensile sticking without declared cohesion; support may transfer to side walls; mass flows/falls/recontacts continuously and conservatively",
      "reference": "Support inequalities plus REFERENCE_REQUIRED for dense-material dynamics",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C12",
      "goals": [
        16
      ],
      "kind": "sparse_packet_capacity",
      "criterion": "Recognize existing P capacity is insufficient for this whole detached mass; new bulk representation/capacity required",
      "reference": "Exact finite capacity calculation; not a universal impossibility proof",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C13",
      "goals": [
        17
      ],
      "kind": "phase_wrap",
      "criterion": "No artificial -358 degree jump; whole-phase offset is physically equivalent within the declared arithmetic domain",
      "reference": "Phase algebra and independently prescribed derivatives",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C14",
      "goals": [
        17
      ],
      "kind": "stop_and_reverse",
      "criterion": "Respond to the complete motion path; sand need not reverse instantly or have same state at same final angle",
      "reference": "Declared input/force histories and material reference where needed",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C15",
      "goals": [
        17
      ],
      "kind": "repeated_rotation",
      "criterion": "No history clearing to hide drift; all resource/accuracy limits remain explicit; full turn is not a state-return identity",
      "reference": "Independent cumulative audit plus actual sustained device record",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C16",
      "goals": [
        17,
        19
      ],
      "kind": "axis_scope",
      "criterion": "Declare or reject out-of-plane motion in a planar profile; genuine coverage requires justified finite-gap/3D physics",
      "reference": "Coordinate/scope audit; no restoration of paused goal10",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C17",
      "goals": [
        18
      ],
      "kind": "same_mean_different_profile",
      "criterion": "All have mass=1 and momentum=1 but different energies/fluxes; chosen representation must distinguish target observables",
      "reference": "Exact profile integrals",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C18",
      "goals": [
        18
      ],
      "kind": "counterflow_and_layer_order",
      "criterion": "Net momentum=0 does not mean rest; equal variance does not fix basal velocity or layer ordering",
      "reference": "Exact two-mass algebra",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C19",
      "goals": [
        18
      ],
      "kind": "layer_exchange_and_load",
      "criterion": "Paired internal force and nonnegative friction loss; no repeated full-bed friction or forced equal-velocity remix; full spatial closure still required",
      "reference": "Finite impulse identity and REFERENCE_REQUIRED for actual shear law",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C20",
      "goals": [
        18
      ],
      "kind": "two_four_layer_or_volume_selection",
      "criterion": "Choose sufficient representation by target-observable error and cost; two layers are not frozen in advance; no duplicated mass if volume model resolves profile",
      "reference": "REFERENCE_REQUIRED plus resolution/error-budget comparison",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C21",
      "goals": [
        19
      ],
      "kind": "finite_gap_water_channel",
      "criterion": "Compare u=f*z*(b-z)/(2nu), mean=f*b^2/(12nu), wall shear magnitude=rho*f*b/2; refine Nz and time independently",
      "reference": "Analytic fully developed laminar channel, not a closed-box circulating-flow solution",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C22",
      "goals": [
        19
      ],
      "kind": "true_transverse_motion",
      "criterion": "Independent physical depth motion/response present and conservative; observe cross-sections and oblique view, not only the front image",
      "reference": "Manufactured transverse subproblem plus material/flow references as applicable",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C23",
      "goals": [
        19
      ],
      "kind": "gap_and_wall_scaling",
      "criterion": "Separate thin-gap closure assumptions from true 3D degrees of freedom; explicitly test boundary resolution and time-scale validity",
      "reference": "Known laminar scale and REFERENCE_REQUIRED for granular wall law",
      "productStatus": "NOT_RUN"
    },
    {
      "id": "C24",
      "goals": [
        19
      ],
      "kind": "three_dimensional_water_sand_feedback",
      "criterion": "Both sand and water use qualified depth dynamics/boundaries and validated interactions; preserve G13/G14/G12 domain-specific evidence and revalidate 3D",
      "reference": "Actual valid G14/G12 interfaces plus independent 3D geometry/solver/material evidence",
      "productStatus": "NOT_RUN"
    }
