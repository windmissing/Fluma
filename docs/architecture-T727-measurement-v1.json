{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T727 shader cold/warm benchmark attempt",
  "description": "One single-process native attempt. Time values use one device CLOCK_MONOTONIC domain. Structural validation alone does not prove same-scope joins or correctness. Rules and experimental design are in architecture-T727-v1.md.",
  "type": "object",
  "properties": {
    "revision": {
      "const": "T727_SHADER_MEASUREMENT_V1"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "outcomes": {
      "$ref": "#/$defs/outcomes"
    },
    "steady": {
      "$ref": "#/$defs/steady"
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "originals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/original"
      }
    }
  },
  "required": [
    "revision",
    "identity",
    "experiment",
    "programs",
    "events",
    "outcomes",
    "steady",
    "resource",
    "originals"
  ],
  "additionalProperties": false,
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Native decimal unsigned integer. Reader enforces <= UINT64_MAX. Null, when allowed, marks an unavailable value."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "contextOrDeviceGeneration": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerTid": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "surface": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "epoch": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissionRevision": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "window",
        "contextOrDeviceGeneration",
        "ownerTid",
        "surface",
        "run",
        "epoch",
        "session",
        "permissionRevision"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "route": {
          "enum": [
            "G13",
            "RX",
            "DM",
            "M1",
            "M2"
          ]
        },
        "backend": {
          "enum": [
            "GLES",
            "VULKAN"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "osBuild": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "bundleOrExecutable": {
          "type": "string",
          "minLength": 1
        },
        "packageOrExecutableSha": {
          "$ref": "#/$defs/sha256"
        },
        "loadedModuleBuildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "loadedModuleSha": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "pid": {
          "$ref": "#/$defs/u64"
        },
        "processStartId": {
          "type": "string",
          "minLength": 1
        },
        "nativeBoot": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeTicket": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "configSha": {
          "$ref": "#/$defs/sha256"
        },
        "inputSha": {
          "$ref": "#/$defs/sha256"
        },
        "seedSha": {
          "$ref": "#/$defs/sha256"
        },
        "presentationRoute": {
          "enum": [
            "XCOMPONENT",
            "COMPUTE_ONLY"
          ]
        }
      },
      "required": [
        "route",
        "backend",
        "device",
        "osBuild",
        "driver",
        "bundleOrExecutable",
        "packageOrExecutableSha",
        "loadedModuleBuildId",
        "loadedModuleSha",
        "pid",
        "processStartId",
        "nativeBoot",
        "nativeTicket",
        "attemptId",
        "profile",
        "configSha",
        "inputSha",
        "seedSha",
        "presentationRoute"
      ],
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "variantId": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "enum": [
            "MONOLITH",
            "SPLIT",
            "THREE",
            "TWO",
            "VULKAN_PROTOTYPE"
          ]
        },
        "cachePolicy": {
          "enum": [
            "OFF",
            "ON"
          ]
        },
        "condition": {
          "enum": [
            "APP_COLD",
            "WARM_NEW_PROCESS",
            "PARTIAL_HIT",
            "INCOMPATIBLE",
            "CORRUPT",
            "WARM_NEW_CONTEXT"
          ]
        },
        "appCacheInventoryOriginalId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "driverCacheCondition": {
          "enum": [
            "UNKNOWN",
            "OBSERVED_CONDITION"
          ]
        },
        "thermalCondition": {
          "enum": [
            "UNKNOWN",
            "COMPARABLE",
            "DIFFERENT"
          ]
        },
        "foregroundCondition": {
          "enum": [
            "FOREGROUND",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "orderInGroup": {
          "type": "integer",
          "minimum": 0
        },
        "observationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "observeStartNs": {
          "$ref": "#/$defs/u64"
        },
        "observeEndNs": {
          "$ref": "#/$defs/u64"
        },
        "captureLimits": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "groupId",
        "variantId",
        "variant",
        "cachePolicy",
        "condition",
        "appCacheInventoryOriginalId",
        "driverCacheCondition",
        "thermalCondition",
        "foregroundCondition",
        "orderInGroup",
        "observationPolicy",
        "observeStartNs",
        "observeEndNs",
        "captureLimits"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "roleGeneration": {
          "$ref": "#/$defs/u64"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "sourceOrSpirvSha": {
          "$ref": "#/$defs/sha256"
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "layoutSha": {
          "$ref": "#/$defs/sha256"
        },
        "bindingOrLinkConfigSha": {
          "$ref": "#/$defs/sha256"
        },
        "environmentSha": {
          "$ref": "#/$defs/sha256"
        },
        "cacheKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheLookup": {
          "enum": [
            "OFF",
            "MISS",
            "FOUND",
            "KEY_MISMATCH",
            "CORRUPT",
            "NOT_REACHED",
            "UNKNOWN"
          ]
        },
        "binaryLoad": {
          "enum": [
            "NOT_ATTEMPTED",
            "ACCEPTED_AFTER_REFLECTION",
            "REJECTED",
            "OPEN",
            "UNKNOWN"
          ]
        },
        "vkPipelineCacheFeedback": {
          "enum": [
            "HIT_REPORTED",
            "MISS_REPORTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "binaryFormat": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "binarySha": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "binaryBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "persistence": {
          "enum": [
            "NOT_REACHED",
            "EXPORT_ONLY",
            "WRITE_PENDING",
            "PERSISTED",
            "WRITE_FAILED",
            "UNSUPPORTED",
            "UNKNOWN"
          ]
        },
        "sourceCompileCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFallbackCount": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "id",
        "roleGeneration",
        "scope",
        "sourceOrSpirvSha",
        "payloadBytes",
        "layoutSha",
        "bindingOrLinkConfigSha",
        "environmentSha",
        "cacheKey",
        "cacheLookup",
        "binaryLoad",
        "vkPipelineCacheFeedback",
        "binaryFormat",
        "binarySha",
        "binaryBytes",
        "persistence",
        "sourceCompileCount",
        "sourceFallbackCount"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/u64"
        },
        "ns": {
          "$ref": "#/$defs/u64"
        },
        "tid": {
          "$ref": "#/$defs/u64"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "operation": {
          "enum": [
            "LAUNCH",
            "CONFIG_ACTION",
            "CONFIG_RECEIVED",
            "CONFIG_ADMITTED",
            "OWNER_SEEN",
            "CONTEXT_READY",
            "CACHE_PRELOAD",
            "CACHE_LOOKUP",
            "CACHE_EXPORT",
            "CACHE_PERSIST",
            "CREATE",
            "GL_COMPILE_SHADER",
            "GL_COMPILE_STATUS",
            "GL_LINK_PROGRAM",
            "GL_LINK_STATUS",
            "GL_PROGRAM_BINARY",
            "GL_INFO_LOG",
            "VK_SHADER_MODULE",
            "VK_PIPELINE_CACHE_LOAD",
            "VK_COMPUTE_PIPELINE",
            "VK_GRAPHICS_PIPELINE",
            "REFLECT",
            "PREPARE",
            "ALLOCATE",
            "BOOT_DISPATCH",
            "BOOT_FENCE",
            "BOOT_READBACK",
            "BOOT_AUDIT",
            "COMPUTE_READY",
            "ACTIVATION",
            "ROOT_BEGIN",
            "ROOT_ACCEPTED",
            "FIRST_REAL_DRAW",
            "PRESENT",
            "OBSERVATION_END",
            "PROCESS_EXIT",
            "REVOKE",
            "RETIRE"
          ]
        },
        "edge": {
          "enum": [
            "ENTER",
            "RETURNED",
            "EXIT",
            "MARK"
          ]
        },
        "granularity": {
          "enum": [
            "EXACT_NATIVE_CALL",
            "COMPOSITE_PHASE",
            "NATIVE_MARK"
          ]
        },
        "invocationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "programId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rootToken": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rawReturn": {
          "anyOf": [
            {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rawError": {
          "anyOf": [
            {
              "type": [
                "string",
                "integer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "originalId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sequence",
        "ns",
        "tid",
        "scope",
        "operation",
        "edge",
        "granularity",
        "invocationId",
        "programId",
        "rootToken",
        "rawReturn",
        "rawError",
        "originalId"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "OBSERVED_SUCCESS",
            "OBSERVED_FAILURE",
            "OPEN_AT_OBSERVATION_END",
            "NOT_REACHED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "eventSequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "ns": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "rootToken": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "eventSequence",
        "ns",
        "rootToken"
      ],
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "properties": {
        "configure": {
          "$ref": "#/$defs/endpoint"
        },
        "create": {
          "$ref": "#/$defs/endpoint"
        },
        "ready": {
          "$ref": "#/$defs/endpoint"
        },
        "firstAcceptedRoot": {
          "$ref": "#/$defs/endpoint"
        },
        "firstValidSwap": {
          "$ref": "#/$defs/endpoint"
        },
        "terminalReason": {
          "enum": [
            "COMPLETE",
            "DEADLINE_CENSORED",
            "CANCELLED",
            "FIRST_NATIVE_FAILURE",
            "PROCESS_EXIT",
            "OBSERVATION_LOST",
            "UNKNOWN"
          ]
        },
        "firstFailureOriginalId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
