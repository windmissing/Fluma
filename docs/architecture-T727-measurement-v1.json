        "numericalResult": {
          "enum": [
            "PASS_EXISTING_ORACLE",
            "FAIL_EXISTING_ORACLE",
            "NOT_MEASURED"
          ]
        },
        "originalReference": {
          "enum": [
            "MATCHED_ORIGINAL_RUN",
            "FROZEN_ORACLE_ONLY",
            "NOT_AVAILABLE"
          ]
        }
      },
      "required": [
        "configure",
        "create",
        "ready",
        "firstAcceptedRoot",
        "firstValidSwap",
        "terminalReason",
        "firstFailureOriginalId",
        "numericalResult",
        "originalReference"
      ],
      "additionalProperties": false
    },
    "steady": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sampleBeginNs": {
              "$ref": "#/$defs/u64"
            },
            "sampleEndNs": {
              "$ref": "#/$defs/u64"
            },
            "validNewFrameCount": {
              "type": "integer",
              "minimum": 0
            },
            "acceptedQCount": {
              "type": "integer",
              "minimum": 0
            },
            "repeatedFrameCount": {
              "type": "integer",
              "minimum": 0
            },
            "staleFrameCount": {
              "type": "integer",
              "minimum": 0
            },
            "frameIntervalsOriginalId": {
              "type": "string",
              "minLength": 1
            },
            "rootCostsOriginalId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "sampleBeginNs",
            "sampleEndNs",
            "validNewFrameCount",
            "acceptedQCount",
            "repeatedFrameCount",
            "staleFrameCount",
            "frameIntervalsOriginalId",
            "rootCostsOriginalId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "gpuKnownBytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hostKnownBytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cachePayloadBytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheTransientBytes": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "accountingOriginalId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "gpuKnownBytes",
            "hostKnownBytes",
            "cachePayloadBytes",
            "cacheTransientBytes",
            "accountingOriginalId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
