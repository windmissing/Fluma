  "requiredBaselineInventory": "analysis-T205-source-ledger-inventory-v1.json:sourceSites and source files",
  "budgetRules": {
    "pairIdBytesPerView": "96*N",
    "ticketBytesPerView": "48*Qcap",
    "certificateBaseBytesPerView": "32*N+64*C+64*stageSlots",
    "extraCertificateDependencyBytesPerView": "4*stageSlots*dependencyMaskWords+8*dependencyDomains+2*C + stageSlots",
    "undoBytes": "24*undoRecords+64*depthMax",
    "upperUndoCapacity": ">=depthMax*w_upper conservative until implementation proves single-log bound",
    "wholeMemory": "M_inherited_unique_backings + sum(newArrays with actual instance scopes) + original field/source/step banks and schema bytes not already inherited + native heap + renderer overlap + caller snapshots; unknown multiplicity => NOT_TOTALLED",
    "output": "ZioSlotMax calculated from full schema worst UTF8 escaping and record count, not mean JSON size"
  },
  "workEnvelope": {
    "hA": "ceil(2*log2(N+1))",
    "hR": "ceil(log2(N+1))",
    "findNodes": "6*hR*hA+4*hA+fixedHead",
    "insertEraseNodes": "64*hA+fixedHead per primitive; relocate=erase+insert",
    "sourceSeedMax": "2*C*Rmax",
    "birthFindMax": "B_enter",
    "audit": "A_logical=A_execute+A_certHit; A_execute may equal all logical calls",
    "gpuSSBOBytes": "2*(256+16*K*(h+1)+32*K+32*K+32*K+128)",
    "gpuUploadBytesPerRequest": "256+16*K+32*K+128",
    "gpuIdentitySha": "messageByteLength plus real SHA256 padding blocks ceil((length+9)/64); count each digest separately",
    "total": "root call-set exclusive work sum; residual ordered-fold and field C^2 explicitly retained",
    "wallLimits": "PENDING_DEVICE_CALIBRATION; no hard realtime claim"
  },
