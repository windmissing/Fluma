#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x=64) in;
// Array order: walls at 0 and faceCount-1, internal faces between them.
struct InputFace { uint bedL,flowL,bedR,flowR; ivec2 pL,pR; };
layout(std430,binding=0) readonly buffer Input {
 int width,startQ8,endQ8; uint tick,muQ16,faceCount,gravity,j; InputFace faces[];
};
layout(std430,binding=1) readonly buffer Angles { ivec2 projection[]; };
struct OutputFace {
 int q; uint status,leftDepth,rightDepth; uvec2 impulse,correctionL,correctionR;
 int angleQ8; uint poseTick; uvec2 drive,normal;
};
layout(std430,binding=2) writeonly buffer Output { OutputFace result[]; };
const uint Cap=268435456u;
const int64_t Q20=1048576l;
/* T647_WIDE */
/* G15_POSE */

uvec2 words64(int64_t v){return uvec2(uint(v),uint(uint64_t(v)>>32));}
int64_t roundEven(int64_t n,int64_t d){
 int64_t q=n/d,r=n%d;
 int64_t a=r<0l?-r:r;
 return a>d-a||(a==d-a&&(q&1l)!=0l)?q+(n<0l?-1l:1l):q;
}
bool momentumAt(uvec4 old,uint prior,uint depth,out uvec4 p,out int speed){
 p=uvec4(0u);speed=0;
 if(prior==0u)return depth==0u&&g9Zero(old);
 uvec4 u,work,bound;
 return g9UMul(g9U32(prior),g9U32(1073741824u),bound)&&g9UCmp(g9Magnitude(old),bound)<=0&&
        g9SMul(old,g9U32(depth),work)&&g9SDiv(work,g9U32(prior),1u,p)&&
        (depth==0u||(g9SDiv(p,g9U32(depth),1u,u)&&g9I32(u,speed)&&speed>= -1073741824&&speed<=1073741824));
}
bool pressure(uvec4 p,uint depth,uint gn,out uvec4 value){
 value=uvec4(0u);
 if(depth==0u)return g9Zero(p);
 uvec4 square,kinetic;
 return g9SMul(p,p,square)&&g9SDiv(square,g9U32(depth),1u,kinetic)&&
        g9UMul(g9U32(depth),g9U32(depth),square)&&g9SMul(square,g9U32(gn),square)&&
        g9SDiv(square,g9U32(2u),1u,square)&&g9SAdd(kinetic,square,value);
}
bool correction(uint original,uint reconstructed,uint gn,uvec4 denominator,out uvec2 impulse){
 uvec4 a,b;
 return g9UMul(g9U32(original),g9U32(original),a)&&g9UMul(g9U32(reconstructed),g9U32(reconstructed),b)&&
        g9USub(a,b,a)&&g9SMul(a,g9U32(gn),a)&&g9SDiv(a,g9U32(2u),1u,a)&&
        g9SDiv(a,denominator,1u,a)&&g9I64(a,impulse);
}

OutputFace evaluate(uint i,InputFace f){
 OutputFace outFace=OutputFace(0,1u,0u,0u,uvec2(0u),uvec2(0u),uvec2(0u),groupAngle,tick,uvec2(0u),uvec2(0u));
 if(!groupValid||faceCount<2u||faceCount>129u||width<=0||width>16777216||
    muQ16>65536u||gravity<120u||gravity>1073741824u||j==0u||j>32u||(j&(j-1u))!=0u||projection.length()!=23041)return outFace;
 bool leftWall=i==0u,rightWall=i==faceCount-1u;
 if(leftWall){f.bedL=f.bedR;f.flowL=f.flowR;}
 if(rightWall){f.bedR=f.bedL;f.flowR=f.flowL;}
 if(f.bedL>Cap||f.bedR>Cap||f.flowL>Cap-f.bedL||f.flowR>Cap-f.bedR)return outFace;
 ivec2 gc=projection[groupAngle+11520];
 if(gc.x< -741455||gc.x>741455||gc.y<741455||gc.y>1048576)return outFace;
 int64_t db=int64_t(f.bedR+f.flowR)-int64_t(f.bedL+f.flowL),dx=int64_t(width);
 int64_t drive=int64_t(gc.x)*dx-int64_t(gc.y)*db,normal=int64_t(gc.y)*dx+int64_t(gc.x)*db;
 outFace.drive=words64(drive);outFace.normal=words64(normal);
 if(!leftWall&&!rightWall&&(5l*(db<0l?-db:db)>3l*dx||4l*normal<Q20*dx)){outFace.status=2u;return outFace;}
 int64_t shift=(leftWall||rightWall)?0l:int64_t(gc.x)*dx;
 int64_t left=int64_t(f.bedL)*gc.y,right=int64_t(f.bedR)*gc.y-shift,bottom=max(left,right);
 outFace.leftDepth=uint(roundEven(max(0l,left+int64_t(f.flowL)*gc.y-bottom),int64_t(gc.y)));
 outFace.rightDepth=uint(roundEven(max(0l,right+int64_t(f.flowR)*gc.y-bottom),int64_t(gc.y)));
 uint gn=uint(roundEven(int64_t(gravity)*gc.y,Q20));
 uvec4 pl=g9S64(uvec2(f.pL)),pr=g9S64(uvec2(f.pR));
 if(leftWall&&!g9SNeg(pr,pl))return outFace;
 if(rightWall&&!g9SNeg(pl,pr))return outFace;
 bool stationaryPair=g9Zero(pl)&&g9Zero(pr);
 int ul,ur;uint sl,sr;
 uvec4 speedL,speedR;
 if(!momentumAt(pl,f.flowL,outFace.leftDepth,pl,ul)||!momentumAt(pr,f.flowR,outFace.rightDepth,pr,ur)||
    !g9UMul(g9U32(gn),g9U32(outFace.leftDepth),speedL)||!g9UMul(g9U32(gn),g9U32(outFace.rightDepth),speedR)||
    !g9CeilSqrt64(speedL.xy,sl)||!g9CeilSqrt64(speedR.xy,sr))return outFace;
 uint wave=max(uint(abs(ul))+sl,uint(abs(ur))+sr);
 if(20l*int64_t(wave)>9l*dx*120l*int64_t(j)){outFace.status=3u;return outFace;}
 uvec4 speed=g9U32(wave),difference,visc,fm,fp,al,ar;
 uvec4 denominator;
 if(!g9UMul(g9U32(uint(width)),g9U32(120u*j),denominator)||
    !g9SSub(g9U32(outFace.rightDepth),g9U32(outFace.leftDepth),difference)||
    !g9SMul(speed,difference,visc)||!g9SAdd(pl,pr,fm)||!g9SSub(fm,visc,fm)||!g9SDiv(fm,g9U32(2u),1u,fm)||
    !pressure(pl,outFace.leftDepth,gn,al)||!pressure(pr,outFace.rightDepth,gn,ar)||!g9SSub(pr,pl,difference)||
    !g9SMul(speed,difference,visc)||!g9SAdd(al,ar,fp)||!g9SSub(fp,visc,fp)||!g9SDiv(fp,g9U32(2u),1u,fp)||
    !g9SDiv(fm,denominator,0u,fm)||!g9I32(fm,outFace.q)||!g9SDiv(fp,denominator,1u,fp)||!g9I64(fp,outFace.impulse)||
    !correction(f.flowL,outFace.leftDepth,gn,denominator,outFace.correctionL)||
    !correction(f.flowR,outFace.rightDepth,gn,denominator,outFace.correctionR))return outFace;
 int64_t scaled=drive*65536l,limit=int64_t(muQ16)*normal;
 if(leftWall||rightWall||(stationaryPair&&scaled>= -limit&&scaled<=limit))outFace.q=0;
 outFace.status=0u;
 return outFace;
}

#ifdef G15_CORRECTOR
uint midpoint(uint c,uint flow,inout ivec2 momentum){
 OutputFace left=evaluate(c,faces[c]),right=evaluate(c+1u,faces[c+1u]);
 // Keep F immutable, as in the parent. Round (pEntry + pPredict) / 2 once.
 if(left.status!=0u)return left.status;
 if(right.status!=0u)return right.status;
 uvec4 p=g9S64(uvec2(momentum)),change,bed,mid,bound,speed,depthWave;
 uvec2 words;
 if(!g9SSub(g9S64(left.impulse),g9S64(right.impulse),change)||
    !g9SSub(g9S64(left.correctionR),g9S64(right.correctionL),bed)||
    !g9SAdd(p,p,mid)||!g9SAdd(mid,change,mid)||!g9SAdd(mid,bed,mid)||
    !g9SDiv(mid,g9U32(2u),1u,mid)||!g9UMul(g9U32(flow),g9U32(1073741824u),bound)||
    g9UCmp(g9Magnitude(mid),bound)>0||!g9I64(mid,words))return 1u;
 if(flow!=0u){
  uint gn=uint(roundEven(int64_t(gravity)*projection[groupAngle+11520].y,Q20)),wave;
  if(!g9SDiv(g9Magnitude(mid),g9U32(flow),3u,speed)||!g9UMul(g9U32(gn),g9U32(flow),depthWave)||
     !g9CeilSqrt64(depthWave.xy,wave))return 1u;
  if(20l*(int64_t(speed.x)+wave)>9l*int64_t(width)*120l*int64_t(j))return 3u;
 }
 momentum=ivec2(words);
 return 0u;
}

OutputFace correct(uint i){
 InputFace f=faces[i];
 uint reason=i==0u?0u:midpoint(i-1u,f.flowL,f.pL);
 if(reason==0u&&i+1u<faceCount)reason=midpoint(i,f.flowR,f.pR);
 if(reason!=0u)
  return OutputFace(0,reason,0u,0u,uvec2(0u),uvec2(0u),uvec2(0u),groupAngle,tick,uvec2(0u),uvec2(0u));
 return evaluate(i,f);
}
#endif

void main(){
 if(gl_LocalInvocationIndex==0u)groupValid=poseAt(groupAngle);
 barrier();
 uint i=gl_GlobalInvocationID.x;
 if(i<faceCount&&i<faces.length()&&i<result.length()){
#ifdef G15_CORRECTOR
  result[i]=correct(i);
#else
  result[i]=evaluate(i,faces[i]);
#endif
 }
}
