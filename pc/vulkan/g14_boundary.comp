    if(i==0u)O[32u+child]=O[16]==0u?seal:0xd0149571u;
}
void sealRoot(){
    if(O[16]!=0u)return;
    for(uint i=0u;i<count;++i)if(O[32u+i]!=seal){fail(7u,3u,0u,i,0.,0.);return;}
    O[14]=2u+6u*count;O[15]=I[2]==2u?2u:1u;O[63]=seal;
}
