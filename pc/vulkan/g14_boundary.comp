void main(){
    uint i=gl_GlobalInvocationID.x;
#if ROLE == 2
    if(op==0u){if(i==0u)freeze();return;}
    if(op==7u){if(i==0u)sealRoot();return;}
    if(op==6u && (O[16]==0u || (O[17]==5u&&O[18]==child))){sealInterval();return;}
#endif
    if(O[16]!=0u||child>=count)return;
#if ROLE == 0
    if(op==1u&&i<nc())cutCell(i);
    if(op==2u){if(i<nf())cutFace(i);if(i<nc())cutPiece(i);}
#elif ROLE == 1
    if(op==3u&&i<nf())transport(i);
    if(op==4u&&i<nc())traction(i);
#else
    if(op==5u&&i==0u)audit();
#endif
}

#if ROLE == 1
double psi(double x,double y,double t,uint col){
    double b=bed(x,t,col),h=heightY()-b;
    if(I[2]==1u){
        double speed=(I[6]&1u)==0u?.030LF:-.030LF;
        return speed*(y-b)*(y-b)/(2.*h);
    }
    double xi=x/lengthX(),eta=clamp((y-b)/h,0.,1.);
    return -lengthX()*.020LF*(xi*xi-xi)*(1.-3.*eta*eta+2.*eta*eta*eta);
}
double faceRate(Face f,double t){
    if(I[2]==2u&&(I[6]&16u)!=0u&&f.vertical&&f.x==1u)return .00125LF;
    if(f.closed)return 0.;
    if(I[2]==2u)return f.vertical&&f.x==1u?((I[6]&2u)==0u?.00125LF:-.00125LF):0.;
    dvec2 p=opening(f,t);
    if(p.x>=p.y)return 0.;
    double x=double(f.x)*dx(), y=double(f.y)*dy();
    if(f.vertical)return psi(x,y+p.y*dy(),t,min(f.x,nx()-1u))-psi(x,y+p.x*dy(),t,min(f.x,nx()-1u));
    return psi(x+p.x*dx(),y,t,f.x)-psi(x+p.y*dx(),y,t,f.x);
}
void transport(uint id){
    Face f=faceFor(id);
    double t0=start(),t1=end(),sum=0.,coarse=0.,split=t1,previous=t0;
    uint first=0u,last=0u,transitions=0u;
    // For the frozen slope family, resolve the open horizontal face's
    // observed sign changes separately from events that change topology.
    uint subdivisions=I[2]==3u&&!f.vertical&&!f.closed?32u:1u;
    for(uint q=0u;q<=subdivisions;++q){
        double t=mixD(t0,t1,double(q)/double(subdivisions)),v=faceRate(f,t);
        uint signId=v>1e-18LF?1u:v< -1e-18LF?2u:0u;
        if(signId==0u)continue;
        if(first==0u)first=signId;
        if(last!=0u&&signId!=last){
            transitions++;
            if(transitions==1u){
                double lo=previous,hi=t;
                for(uint r=0u;r<32u;++r){
                    double mid=(lo+hi)*.5LF;
                    if((faceRate(f,mid)>0.)==(last==1u))lo=mid;else hi=mid;
                }
                split=(lo+hi)*.5LF;
            }
        }
        last=signId;previous=t;
    }
    uint signMask=first|last|(transitions>1u?4u:0u),panels=transitions==1u?2u:1u;
    for(uint panel=0u;panel<panels;++panel){
        double lo=panel==0u?t0:split,hi=panel==0u&&panels==2u?split:t1;
        for(uint q=0;q<8;++q){
            double v=faceRate(f,mixD(lo,hi,cNode[q]));
            uint signId=v>1e-18LF?1u:v< -1e-18LF?2u:0u;
            uint expected=panels==2u?(panel==0u?first:last):first;
            if(signId!=0u && signId!=expected)signMask|=4u;
            sum+=(hi-lo)*cWeight[q]*v;
        }
        for(uint q=0;q<4;++q)coarse+=(hi-lo)*sWeight[q]*faceRate(f,mixD(lo,hi,sNode[q]));
    }
    uint at=fluxAt(id);
    A[at]=id;A[at+1u]=signMask;
    storeA(at+2u,sum);storeA(at+4u,abs(sum-coarse));
    A[at+6u]=(first<<30u)|(last<<28u)|(panels==2u?uint(round((split-t0)/(t1-t0)*16777216.)):0u);
    A[at+7u]=8u*panels;
}
void traction(uint id){
    uint at=loadAt(id),col=id%nx(),row=id/nx();
    bool present=G[BEDPIECE_BASE+id*BEDPIECE_STRIDE+3u]!=0u;
    double total[12],coarse[12];
    for(uint i=0u;i<12u;++i){total[i]=0.;coarse[i]=0.;}
    double t0=start(),t1=end(),duration=t1-t0;
    bool normalMismatch=false;
    if(present)for(uint rule=0u;rule<2u;++rule){
        uint n=rule==0u?8u:4u;
        for(uint q=0u;q<n;++q){
            double t=mixD(t0,t1,rule==0u?cNode[q]:sNode[q]),s=slope(t),metric=sqrt(1.+s*s);
            dvec2 clipped=wallSpan(col,row,t);
            for(uint r=0u;r<n;++r){
                double local=mixD(clipped.x,clipped.y,rule==0u?cNode[r]:sNode[r]);
                double x=(double(col)+local)*dx(),y=bed(x,t,col),xi=x/lengthX();
                double weight=metric*dx()*(clipped.y-clipped.x)*duration*
                    (rule==0u?cWeight[q]*cWeight[r]:sWeight[q]*sWeight[r]);
                if(I[2]==3u){
                    // -∂x psi at eta=0, where the eta derivative vanishes.
                    double flowV=(lengthX()*.020LF)*(2.*xi-1.)/lengthX();
                    normalMismatch=normalMismatch||abs((flowV-wallSpeed(x,col))/metric)>1e-12LF;
                }
                Forces f=wallForce(x,y,t);
                dvec2 force[3]=dvec2[3](f.p,f.normal,f.shear);
                for(uint k=0u;k<3u;++k){
                    double values[4]=double[4](force[k].x,force[k].y,x*force[k].y-y*force[k].x,
                                               wallSpeed(x,col)*force[k].y);
                    for(uint field=0u;field<4u;++field){
                        uint i=field<2u?2u*k+field:6u+3u*(field-2u)+k;
                        if(rule==0u)total[i]+=weight*values[field];else coarse[i]+=weight*values[field];
                    }
                }
            }
        }
    }
    A[at]=id;A[at+1u]=uint(present)|2u*uint(normalMismatch);A[at+2u]=present?8u:0u;A[at+3u]=present?8u:0u;
    for(uint i=0u;i<12u;++i)storeA(at+4u+2u*i,total[i]);
    double forceError=0.,powerError=0.;
    for(uint i=0u;i<6u;++i)forceError+=abs(total[i]-coarse[i]);
    for(uint i=9u;i<12u;++i)powerError+=abs(total[i]-coarse[i]);
    storeA(at+28u,forceError/duration);storeA(at+30u,powerError/duration);
}
#endif
