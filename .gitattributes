tools/g9rx/** -text whitespace=cr-at-eol,-blank-at-eof
entry/src/main/ets/**/*G9Rx*.ets -text whitespace=cr-at-eol
entry/src/main/cpp/types/libgrs_g9rx/** -text whitespace=cr-at-eol
