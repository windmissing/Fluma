export class T266Clock {
  readonly stepRows:Float64Array=new Float64Array(256*10);stepRowCount:number=0;stepRowsDropped:number=0;
  readonly sourceRows:Float64Array=new Float64Array(256*7);readonly sourceReasons:string[]=new Array<string>(256).fill('');sourceRowCount:number=0;sourceRowsDropped:number=0;
  runId:string='';stateEpoch:number=-1;
  acceptedPhysicsSeconds:number=0;committedSubstepCount:number=0;
  sourceRequestedSeconds:number=0;sourceAdmittedMass:number=0;sourceRejectedCount:number=0;
  firstBirthCommit:number=-1;private birthClock:number=0;
  bind(run:string,epoch:number):void {if(run===this.runId&&epoch===this.stateEpoch)return;this.runId=run;this.stateEpoch=epoch;this.acceptedPhysicsSeconds=0;this.committedSubstepCount=0;this.sourceRequestedSeconds=0;this.sourceAdmittedMass=0;this.sourceRejectedCount=0;this.firstBirthCommit=-1;this.birthClock=0;this.stepRowCount=0;this.stepRowsDropped=0;this.sourceRowCount=0;this.sourceRowsDropped=0;}
  committed(count:number,substepDt:number):void {if(!Number.isInteger(count)||count<0||!Number.isFinite(substepDt)||substepDt<0)throw new Error('T266_BAD_COMMIT_EVIDENCE');this.acceptedPhysicsSeconds+=count*substepDt;this.committedSubstepCount+=count;}
  source(seconds:number,mass:number,birth:boolean,commit:number,rejected:boolean,sequence:number=0,commitBefore:number=-1,reason:string='NOT_CAPTURED'):void {this.sourceRequestedSeconds+=seconds;this.sourceAdmittedMass+=mass;if(rejected)this.sourceRejectedCount++;if(birth&&this.firstBirthCommit<0){this.firstBirthCommit=commit;this.birthClock=this.acceptedPhysicsSeconds;}if(this.sourceRowCount===256){this.sourceRowsDropped++;return;}const i=this.sourceRowCount++,at=i*7;this.sourceRows[at]=sequence;this.sourceRows[at+1]=seconds;this.sourceRows[at+2]=mass;this.sourceRows[at+3]=commitBefore;this.sourceRows[at+4]=commit;this.sourceRows[at+5]=rejected?1:0;this.sourceRows[at+6]=this.acceptedPhysicsSeconds;this.sourceReasons[i]=reason;}
  get acceptedSeconds():number{return this.acceptedPhysicsSeconds;}
  get stepCount():number{return this.committedSubstepCount;}
  stepEvidence(frame:number,requestedDt:number,count:number,subDt:number,before:number,after:number,ok:boolean,firstCode:number):void {const old=this.acceptedPhysicsSeconds;this.committed(count,subDt);if(this.stepRowCount===256){this.stepRowsDropped++;return;}const at=this.stepRowCount++*10;this.stepRows[at]=frame;this.stepRows[at+1]=requestedDt;this.stepRows[at+2]=count;this.stepRows[at+3]=subDt;this.stepRows[at+4]=before;this.stepRows[at+5]=after;this.stepRows[at+6]=ok?1:0;this.stepRows[at+7]=firstCode;this.stepRows[at+8]=old;this.stepRows[at+9]=this.acceptedPhysicsSeconds;}
  get secondsSinceFirstBirth():number{return this.firstBirthCommit<0?NaN:this.acceptedPhysicsSeconds-this.birthClock;}
  summary():string{return JSON.stringify({revision:'T266_RUN_CLOCK_V2',runId:this.runId,stateEpoch:this.stateEpoch,acceptedPhysicsSeconds:this.acceptedPhysicsSeconds,acceptedPhysicsSecondsSinceFirstBirth:this.firstBirthCommit<0?null:this.acceptedPhysicsSeconds-this.birthClock,committedSubstepCount:this.committedSubstepCount,sourceRequestedSeconds:this.sourceRequestedSeconds,sourceAdmittedMass:this.sourceAdmittedMass,sourceRejectedCount:this.sourceRejectedCount,admittedEquivalentSeconds:this.sourceAdmittedMass/8,firstBirthCommit:this.firstBirthCommit<0?null:this.firstBirthCommit});}
}
