import {TxFaultPlan} from './TxFaultPlan';
export class TxAfterFault {
 enabled:boolean=true;plan:TxFaultPlan|null=null;hit:boolean=false;readonly rows:string[]=[];capture:()=>string=():string=>'NOT_CAPTURED';context:()=>string=():string=>'NOT_CAPTURED';private seen:number=0;private reading:boolean=false;private backup:string='';private backupRoot:number=0;private readonly observed:Uint8Array=new Uint8Array(1024);dropped:number=0;
 pick(cut:number,root:number,scope:number,input:string,before:number,after:number):boolean {const p=this.plan;if(!this.enabled||p===null||p.edge!=='AFTER'||p.cutId!==cut||p.rootId!==root||this.hit||++this.seen!==p.ordinal)return false;this.hit=true;this.record(JSON.stringify({kind:'NEXT_INPUT',root:root,scopeId:scope,plan:p,traceContext:this.context(),consumerCut:cut===4?335:cut===1||cut===2?1:7,input:input,before:before,after:after,raw:this.capture()}));return true;}
