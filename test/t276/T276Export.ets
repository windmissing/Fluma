export interface T276Part {revision:string;exportId:string;partIndex:number;partCount:number;byteCount:number;totalBytes:number;digest:number;partDigest:number;hex:string;}
export function t276Hash(s:string):number {let h=2166136261;for(let i=0;i<s.length;i++){const v=s.charCodeAt(i);h=Math.imul(h^(v&255),16777619);h=Math.imul(h^(v>>>8),16777619);}return h>>>0;}
export function t276Export(id:string,payload:string,emit:(line:string)=>void):void {if(id.length>180)throw new Error('T276_ID_BOUND');const n=Math.max(1,Math.ceil(payload.length/256)),digest=t276Hash(payload);for(let i=0;i<n;i++){const s=payload.slice(i*256,(i+1)*256);let hex='';for(let j=0;j<s.length;j++)hex+=s.charCodeAt(j).toString(16).padStart(4,'0');const p:T276Part={revision:'T276_COLD_UTF16LE_V1',exportId:id,partIndex:i,partCount:n,byteCount:s.length*2,totalBytes:payload.length*2,digest:digest,partDigest:t276Hash(s),hex:hex};const raw=JSON.stringify(p);if(raw.length>1800)throw new Error('T276_LOG_BOUND');emit('T276_COLD_V1 '+raw);}}
export interface T276Assembly {status:string;payload:string;reason:string;}
export function t276Assemble(parts:T276Part[]):T276Assembly {if(parts.length===0)return {status:'INCOMPLETE',payload:'',reason:'NO_PARTS'};const first=parts[0],ordered:T276Part[]=[];if(parts.length!==first.partCount)return {status:'INCOMPLETE',payload:'',reason:'MISSING_PART'};for(const p of parts){if(p.exportId!==first.exportId||p.partCount!==first.partCount||p.digest!==first.digest||p.totalBytes!==first.totalBytes||!Number.isInteger(p.partIndex)||p.partIndex<0||p.partIndex>=first.partCount||ordered[p.partIndex]!==undefined||p.hex.length%4!==0)return {status:'INCOMPLETE',payload:'',reason:'IDENTITY_OR_DUPLICATE'};ordered[p.partIndex]=p;}let result='';for(const p of ordered){if(p===undefined)return {status:'INCOMPLETE',payload:'',reason:'MISSING_PART'};let s='';for(let i=0;i<p.hex.length;i+=4)s+=String.fromCharCode(parseInt(p.hex.slice(i,i+4),16));if(s.length*2!==p.byteCount||t276Hash(s)!==p.partDigest)return {status:'INCOMPLETE',payload:'',reason:'PART_DIGEST'};result+=s;}return result.length*2===first.totalBytes&&t276Hash(result)===first.digest?{status:'COMPLETE',payload:result,reason:'NONE'}:{status:'INCOMPLETE',payload:'',reason:'TOTAL_DIGEST'};}
