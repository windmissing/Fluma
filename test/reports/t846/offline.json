  "caseContracts": {
    "C17": {
      "id": "C17",
      "goals": [
        18
      ],
      "kind": "same_mean_different_profile",
      "input": "Unit thickness/density profiles u=1, u=2z, and lower half 0 upper half 2",
      "observe": [
        "mass",
        "mean momentum",
        "kinetic energy",
        "advective second moment",
        "top and basal speed"
      ],
      "criterion": "All have mass=1 and momentum=1 but different energies/fluxes; chosen representation must distinguish target observables",
      "negativeControl": "Assume the mean velocity uniquely determines top and basal response",
      "reference": "Exact profile integrals",
      "productStatus": "NOT_RUN"
    },
    "C18": {
      "id": "C18",
      "goals": [
        18
      ],
      "kind": "counterflow_and_layer_order",
      "input": "Equal half-mass layers with velocities -1,+1 and their vertically swapped state",
      "observe": [
        "net momentum",
        "each-layer velocity",
        "energy",
        "basal response",
        "rest flags"
      ],
      "criterion": "Net momentum=0 does not mean rest; equal variance does not fix basal velocity or layer ordering",
      "negativeControl": "Deposit both counterflowing layers because total momentum is zero",
      "reference": "Exact two-mass algebra",
      "productStatus": "NOT_RUN"
    },
    "C19": {
      "id": "C19",
      "goals": [
        18
      ],
      "kind": "layer_exchange_and_load",
      "input": "Paired interlayer friction, donor-momentum mass transfer, top versus basal load and stop/restart",
      "observe": [
        "each-layer mass/origin/momentum",
        "interface impulse",
        "potential and kinetic energy",
        "actual loading response"
      ],
      "criterion": "Paired internal force and nonnegative friction loss; no repeated full-bed friction or forced equal-velocity remix; full spatial closure still required",
      "negativeControl": "Apply basal friction independently twice; add at-rest bed mass at unchanged flow speed",
      "reference": "Finite impulse identity and REFERENCE_REQUIRED for actual shear law",
      "productStatus": "NOT_RUN"
    },
    "C20": {
      "id": "C20",
      "goals": [
        18
      ],
      "kind": "two_four_layer_or_volume_selection",
      "input": "Same physical reference/scenes using single mean, prescribed profile, variance, two/four layers and selected volumetric model",
      "observe": [
        "top/basal speed",
        "flux",
        "shear/load response",
        "errors versus uncertainty",
        "complete GPU cost"
      ],
      "criterion": "Choose sufficient representation by target-observable error and cost; two layers are not frozen in advance; no duplicated mass if volume model resolves profile",
      "negativeControl": "Compare only one fitted steady flow rate; stack an additional physical F on the same continuum mass",
      "reference": "REFERENCE_REQUIRED plus resolution/error-budget comparison",
      "productStatus": "NOT_RUN"
    },
    "C21": {
      "id": "C21",
      "goals": [
        19
      ],
      "kind": "finite_gap_water_channel",
      "input": "Periodic-x, y-invariant parallel plates at z=0,b, no-slip, known nu>0, rho and constant x-acceleration",
      "observe": [
        "u(z)",
        "mean flux",
        "front/back wall shear",
        "wall-normal flow"
      ],
      "criterion": "Compare u=f*z*(b-z)/(2nu), mean=f*b^2/(12nu), wall shear magnitude=rho*f*b/2; refine Nz and time independently",
      "negativeControl": "Only multiply 2D velocity/volume by thickness; compare flow rate while ignoring incorrect wall stress",
      "reference": "Analytic fully developed laminar channel, not a closed-box circulating-flow solution",
      "productStatus": "NOT_RUN"
    },
    "C22": {
      "id": "C22",
      "goals": [
        19
      ],
      "kind": "true_transverse_motion",
      "input": "Localized front/back forcing and out-of-plane gravity with finite-thickness sand/water seed",
      "observe": [
        "w velocity",
        "z origin centroid and distribution",
        "six-wall impulses",
        "cross-sectional geometry"
      ],
      "criterion": "Independent physical depth motion/response present and conservative; observe cross-sections and oblique view, not only the front image",
      "negativeControl": "Extrude rendering or use two sand-height F layers as container-depth freedom",
      "reference": "Manufactured transverse subproblem plus material/flow references as applicable",
      "productStatus": "NOT_RUN"
    },
    "C23": {
      "id": "C23",
      "goals": [
        19
      ],
      "kind": "gap_and_wall_scaling",
      "input": "Vary b, b/d, wall friction and Nz at fixed physical dimensions/mass/material; compare depth-averaged and volumetric candidates",
      "observe": [
        "cross-gap profiles",
        "sand contact/support",
        "water drag and shear",
        "refinement differences",
        "runtime and memory"
      ],
      "criterion": "Separate thin-gap closure assumptions from true 3D degrees of freedom; explicitly test boundary resolution and time-scale validity",
      "negativeControl": "Use water Hele-Shaw friction for grains; hold numerical particle count while silently changing physical grain diameter",
      "reference": "Known laminar scale and REFERENCE_REQUIRED for granular wall law",
      "productStatus": "NOT_RUN"
    },
    "C24": {
      "id": "C24",
      "goals": [
        19
      ],
      "kind": "three_dimensional_water_sand_feedback",
      "input": "Finite-depth sand/water, actual solid occupancy/porosity definition, erosion/lift/transport/redeposit and contour feedback",
      "observe": [
        "water/sand inventories",
        "interface geometry",
        "paired loads and work",
        "suspension/settling",
        "new sand shape",
        "3D solver residuals"
      ],
      "criterion": "Both sand and water use qualified depth dynamics/boundaries and validated interactions; preserve G13/G14/G12 domain-specific evidence and revalidate 3D",
      "negativeControl": "Declare goal19 complete after only 3D sand, or extrapolate 2D pressure/gauge/spectral bounds to arbitrary 3D cut cells",
      "reference": "Actual valid G14/G12 interfaces plus independent 3D geometry/solver/material evidence",
      "productStatus": "NOT_RUN"
    }
  },
  "engineeringConstraints": [
    {
      "id": "E01",
      "area": "SSBO/block/binding/shared/checked arithmetic",
      "class": "DEVICE_QUERY_PLUS_NEW_LAYOUT_UNKNOWN",
      "required": "per-pass actual arrays/buffer/range/offset/stage-active count; observed limits scoped to driver/context, padded bytes and overflow checked"
    },
    {
      "id": "E02",
      "area": "shader/source/cache identity and program scale",
      "class": "EXISTING_ENGINEERING_PATTERN_NOT_SIZE_LIMIT",
      "required": "canonical source/ELF actual bytes, target compile/link/program identity, fatal dependency checks; no inferred KB threshold"
    },
    {
      "id": "E03",
      "area": "dispatch/global synchronization/full work",
      "class": "DESIGN_REQUIRED",
      "required": "all clear/transfer/sort/contact/solver/audit/replay/scene passes and barriers; no cross-workgroup barrier assumption or hidden per-step CPU readback"
    },
    {
      "id": "E04",
      "area": "determinism/atomic/order/wide arithmetic",
      "class": "DESIGN_AND_TARGET_EVIDENCE_REQUIRED",
      "required": "fixed order or proven finite exact accumulation, range/rounding/collision and full state replay, no assumed float atomics"
    },
    {
      "id": "E05",
      "area": "contact/search/history/capacity",
      "class": "CANDIDATE_UNKNOWN",
      "required": "Nd/Ccap/Zcap/Bmax, stable pair+generation key/history; overflow rejects candidate, no truncation"
    },
    {
      "id": "E06",
      "area": "state banks/trial/reject/replay/transaction",
      "class": "DESIGN_REQUIRED",
      "required": "complete physical/source/tensor/contact/geometry/water state, all failed+successful micro work, private proof/atomic commit pattern without reusing old ABI"
    },
    {
      "id": "E07",
      "area": "origin/source ownership",
      "class": "DESIGN_REQUIRED",
      "required": "per-point/mixed-grid source representation and bounds; one owner per actual mass; no silent loss/duplicate mass"
    },
    {
      "id": "E08",
      "area": "topology/dimensionality/geometry/migration",
      "class": "NOT_IN_EXISTING_HEIGHT_STATE",
      "required": "true free-volume/support/position/stress/holes, explicit seed or reconstruction assumption, actual old-new overlap"
    },
    {
      "id": "E09",
      "area": "water geometry/load/interface",
      "class": "HIGHER_PRIORITY_REAL_PREREQUISITES",
      "required": "13 then14 then12 trusted interfaces, GCL/volume/face and total traction/impulse/work; no rectangle-spectrum transfer to 3D/cutcell"
    },
    {
      "id": "E10",
      "area": "scene/shader/accepted token",
      "class": "NEW_REPRESENTATION_DESIGN_REQUIRED",
      "required": "full volume/surface visibility and layer/3D consumers, GPU packing/barriers/fences/lease/fragment cost; no stretch as physics"
    },
    {
      "id": "E11",
      "area": "cold/credit/real retirement",
      "class": "REUSE_PATTERN_NEW_BUDGET_REQUIRED",
      "required": "all new source/history/geometry/water archives, fixed page/builder/reader/TTL bounds, physical freeing and GL retirement before credit return"
    },
    {
      "id": "E12",
      "area": "peak memory/old-new overlap",
      "class": "UNMEASURED",
      "required": "max over actual lifetime, GPU/native/FBO/driver separated; single block limit is not total memory; no net-delta-only budget"
    },
    {
      "id": "E13",
      "area": "rotation input/time/lifetime",
      "class": "DESIGN_AND_INPUT_QUALIFICATION_REQUIRED",
      "required": "unwrapped theta/Omega/alpha/accepted interval/source and overflow, pause/reverse/3D axis; callback receive time not real hand speed"
    },
    {
      "id": "E14",
      "area": "performance/30fps/real-time/thermal",
      "class": "COST_NOT_MEASURED",
      "required": "new accepted frames distinct from STALE repeats, acceptedSimTime/wallTime, root p95/p99/worst/all-trial GPU and submission/thermal costs; no120fps render requirement"
    },
    {
      "id": "E15",
      "area": "reference/cases/provenance/role",
      "class": "REFERENCE_REQUIRED_OR_NOT_RUN",
      "required": "same observable/reference uncertainty and dimension/domain, C01-C24 preserved, tester offline/effector device; planning not physical PASS"
    }
  ],
