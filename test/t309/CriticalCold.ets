import { ClearWaterDiagnostic } from './ClearWaterDiagnostic';
import { TimelineStore,ColdFile } from '../../GpuBridgeTimelineCold';
interface Segment {cursor:number;next:number;firstKey:string;lastKey:string;file:ColdFile;}
interface CriticalManifest {revision:string;packageSha:string;end:string;incomplete:boolean;eventKinds:string[];rowFields:string[];criticalCount:number;criticalCountAfter:number;criticalCapacity:number;criticalDropped:number;firstLostKey:Float64Array;firstLostRunId:string;firstLostReason:string;firstLostUnit:string;firstLostRevision:string;lowCount:number;lowDropped:number;lowSkipped:number;lowSampleRule:string;rowWidth:number;rowBytes:number;criticalTypedBytes:number;lowTypedBytes:number;stringBytes:number;stringBudgetBytes:number;segments:Segment[];frames:ColdFile;low:ColdFile;totalBytes:number;}
export async function exportCriticalCold(d:ClearWaterDiagnostic,store:TimelineStore,sha:string,native:string,yieldUi:()=>Promise<void>):Promise<string> {
 if(!/^[a-f0-9]{64}$/.test(sha))throw new Error('PACKAGE_SHA_REQUIRED');
 if(d.coldBusy)throw new Error('EXPORT_BUSY');d.coldBusy=true;try{
 const count=d.count,dropped=d.criticalDropped,lowCount=d.low.count,prefix='cw-critical-'+Date.now()+'-'+(++d.coldSerial);const segments:Segment[]=[];let totalBytes=0;
 const key=(i:number):string=>{const o=i*64;return JSON.stringify({runId:d.keyRunIds[i]||d.runIds[i],run:d.rows[o+8],config:d.rows[o+9],geometry:d.rows[o+10],input:d.rows[o+11],gesture:d.rows[o+12],source:d.rows[o+13],sequence:d.rows[o+14],kind:d.rows[o+15]});};
 for(let cursor=0;cursor<count;cursor+=256){const next=Math.min(count,cursor+256);const text=JSON.stringify({revision:'CW_C_DIAG_V2_SEGMENT',packageSha:sha,cursor:cursor,next:next,count:count,rows:d.rows.slice(cursor*64,next*64),runIds:d.runIds.slice(cursor,next),keyRunIds:d.keyRunIds.slice(cursor,next),reasons:d.reasons.slice(cursor,next),dispositions:d.dispositions.slice(cursor,next),units:d.units.slice(cursor,next),domains:d.domains.slice(cursor,next),requestRevisions:d.requestRevisions.slice(cursor,next)});const f=await store.save(prefix+'-critical-'+cursor+'.json',text);totalBytes+=f.bytes;if(totalBytes>33554432)throw new Error('COLD_SEGMENT_BYTE_BUDGET');segments.push({cursor:cursor,next:next,firstKey:key(cursor),lastKey:key(next-1),file:f});await yieldUi();}
 // frame3 slots remain independent and copied at capture, never current state.
 const frames=await store.save(prefix+'-frames.json',JSON.stringify({frames:d.frames,firstFrame:d.firstFrame,frameTokens:d.frameTokens,requestedTokens:d.requestedTokens,renderedTokens:d.renderedTokens,lastGoodTokens:d.lastGoodTokens,stages:d.stages,frameData:d.frameData,profiles:d.profiles,headers:d.headers,ledgers:d.ledgers,optics:d.optics,nativeSamples:native}));
 const low=await store.save(prefix+'-low.json',d.low.exportCold(sha));
 const incomplete=dropped>0||d.count!==count||d.criticalDropped!==dropped;
 const meta:CriticalManifest={revision:'CW_C_DIAG_V2',packageSha:sha,end:'END',incomplete:incomplete,eventKinds:['unused','SELECT','STOP','DOWN','TICK','CLOCK_WINDOW','ENQUEUE','BATCH','TERMINAL_QUERY','unused','OLD_KEY_QUERY'],rowFields:['event','owner','currentRunGeneration','currentInputGeneration','currentGeometry','a','b','clockWindow','keyRunGeneration','configRev','keyGeometry','keyInputGeneration','gestureId','sourceId','requestSeq','kind','x','y','requested','timestamp','seed','clockWindowId','valid','reserved','terminalStatus','admitted','rejected','transactionId_or_minus1','kindSuccessSeq_or_minus1','sourceCommit','physicsCommit','globalWaterBefore','globalWaterAfter','columnWaterBefore','columnWaterAfter','actualWaterDelta','I_water','waterSuccessCount','errorStage','replay','globalEventSequence','canonicalSourceCommit','canonicalPhysicsCommit','canonicalI_water','canonicalWaterSuccessCount'],criticalCount:count,criticalCountAfter:d.count,criticalCapacity:d.capacity,criticalDropped:d.criticalDropped,firstLostKey:d.firstLostKey,firstLostRunId:d.firstLostRunId,firstLostReason:d.firstLostReason,firstLostUnit:d.firstLostUnit,firstLostRevision:d.firstLostRevision,lowCount:lowCount,lowDropped:d.low.dropped,lowSkipped:d.lowSkipped,lowSampleRule:'every60 low attempts; first meaningful STOP critical; no key-bearing event sampled',rowWidth:64,rowBytes:512,criticalTypedBytes:d.rows.byteLength,lowTypedBytes:d.low.rows.byteLength,stringBytes:d.stringBytes,stringBudgetBytes:d.stringBudgetBytes,segments:segments,frames:frames,low:low,totalBytes:totalBytes+frames.bytes+low.bytes};
 const manifest=await store.save(prefix+'-manifest.json',JSON.stringify(meta));console.info('CW_C_DIAG_V2_END '+JSON.stringify({file:manifest.name,sha256:manifest.sha256,bytes:manifest.bytes,packageSha:sha,incomplete:incomplete}));return incomplete?'INCOMPLETE':'SEALED';
 }finally{d.coldBusy=false;}
}
