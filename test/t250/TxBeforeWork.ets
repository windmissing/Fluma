function hex(b:ArrayBuffer,bytes:number=b.byteLength):string {const a=new Uint8Array(b,0,bytes);let s='';for(let i=0;i<a.length;i++)s+=a[i].toString(16).padStart(2,'0');return s;}
function pool(p:P011ParticleSnapshot):string[] {const rows:string[]=[];for(let i=0;i<13;i++)rows.push(hex(particleSnapshotBufferAtHot(p,i)));return rows;}
function events(e:P011ParticleHotEventBuffer):string {const buffers=e.coldBuffers(),raw:string[]=[],lengths:number[]=[];for(let i=0;i<buffers.length;i++){const b=buffers[i];const width=i===12?b.byteLength/e.lineageCapacity:i>=37?b.byteLength/(3*e.capacity):b.byteLength/e.capacity;const n=i===12?e.lineageCount:i>=37?e.count*3:e.count;raw.push(hex(b,n*width));lengths.push(b.byteLength);}return JSON.stringify({count:e.count,lineageCount:e.lineageCount,capacity:e.capacity,lineageCapacity:e.lineageCapacity,owner:e.ownerId,epoch:e.stepEpoch,substep:e.substepId,attempt:e.attemptToken,storageOrder:'P011ParticleHotEventBuffer.coldBuffers',unusedCapacity:'NOT_CAPTURED_OUTSIDE_VALID_PREFIX',backingBytes:lengths,activePrefixRaw:raw});}
export function captureBeforeWork(w:P011ParticleHotWorkspace):string {const planA:string[]=[],planB:string[]=[],budget:string[]=[];for(const b of w.planA.coldBuffers())planA.push(hex(b));for(const b of w.planB.coldBuffers())planB.push(hex(b));if(w.budget!==null)for(const b of w.budget.coldBuffers())budget.push(hex(b));const a:BeforePlanRaw={owner:w.planA.ownerId,requests:w.planA.requestCount,motions:w.planA.motionCount,consumed:w.planA.consumed,raw:planA},b:BeforePlanRaw={owner:w.planB.ownerId,requests:w.planB.requestCount,motions:w.planB.motionCount,consumed:w.planB.consumed,raw:planB},ledger:BeforeBudgetRaw={present:w.budget!==null,epoch:w.budget?.diagnosticEpoch??0,open:w.budget?.diagnosticOpenCount??0,totalRemaining:w.budget?.totalRemaining??0,totalUsed:w.budget?.totalUsed??0,raw:budget};return JSON.stringify({revision:'T250_HOT_READSET_RAW_V1',owner:w.ownerId,run:w.runToken,epoch:w.stepEpoch,substep:w.substepId,attempt:w.attemptToken,active:w.active,lastStatus:w.lastStatus,patchToken:w.activePatchToken,patchState:w.patchState,fieldPresent:w.field!==null,planA:a,planB:b,events:events(w.events),patchActions:events(w.patchActions),frozenPool:pool(w.frozenPool),patchBefore:pool(w.patchBefore),patchScratch:pool(w.patchScratch),patchAfter:pool(w.patchAfter),budget:ledger});}
