# T191 H1 only. Included LAST by the isolated V4 generator, never production.
if(NOT TARGET p011_gpu_pair_napi)
  message(FATAL_ERROR "T191_TARGET_MISSING")
endif()
if(NOT T191_BOUND_VARIANT MATCHES "^STRICT_O[02]$")
  message(FATAL_ERROR "T191_VARIANT_REQUIRED")
endif()
set(P011_GPU_STRICT_VARIANT "${T191_BOUND_VARIANT}" CACHE STRING "T191 build identity")
set_property(CACHE P011_GPU_STRICT_VARIANT PROPERTY STRINGS STRICT_O0 STRICT_O2)
if(NOT P011_GPU_STRICT_VARIANT STREQUAL T191_BOUND_VARIANT)
  message(FATAL_ERROR "T191_VARIANT_IDENTITY_CONFLICT")
endif()
if(NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
  message(FATAL_ERROR "T191_REQUIRES_UNCHANGED_DEBUG_CONFIGURATION")
endif()
if(CMAKE_INTERPROCEDURAL_OPTIMIZATION)
  message(FATAL_ERROR "T191_LTO_FORBIDDEN")
endif()
foreach(flags CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG CMAKE_SHARED_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS_DEBUG)
  if("${${flags}}" MATCHES "-Ofast|-ffast-math|-funsafe-math|-fassociative-math|-ffinite-math-only|-flto|-DNDEBUG|-ffp-contract=(fast|on)")
    message(FATAL_ERROR "T191_FORBIDDEN_FLAGS:${flags}")
  endif()
endforeach()
if(T191_BOUND_VARIANT STREQUAL "STRICT_O2")
  target_compile_options(p011_gpu_pair_napi PRIVATE -O2 -fno-fast-math -ffp-contract=off)
else()
  target_compile_options(p011_gpu_pair_napi PRIVATE -O0 -fno-fast-math -ffp-contract=off)
endif()
